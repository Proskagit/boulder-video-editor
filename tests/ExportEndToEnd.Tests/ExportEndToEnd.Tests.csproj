<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AiVideoEditor.ExportEndToEnd.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The app's own Avalonia platform (Win32 + Skia) and fonts: the export's production rasterizer. -->
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Video\Video.csproj" />
    <ProjectReference Include="..\..\src\Timeline\Timeline.csproj" />
    <ProjectReference Include="..\..\src\Export\Export.csproj" />
    <ProjectReference Include="..\..\src\UI\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia initialisation + Preview rendering (Rendering.Tests), ffmpeg tools and output inspection (Video.Tests). -->
    <Compile Include="..\Rendering.Tests\RenderHarness.cs" Link="Shared\RenderHarness.cs" />
    <Compile Include="..\Video.Tests\FfmpegTools.cs" Link="Shared\FfmpegTools.cs" />
    <Compile Include="..\Video.Tests\ExportEncoderHarness.cs" Link="Shared\ExportEncoderHarness.cs" />
  </ItemGroup>

</Project>
