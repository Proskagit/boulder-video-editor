<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase Coros: the local suite on the product owner's real COROS export (personal data, never committed). Deliberately
       NOT part of AiVideoEditor.sln, so the regular CI never builds or runs it (as tests/Vision.ModelTests, D034 §7). Run:
       dotnet test tests/Telemetry.LocalTests/Telemetry.LocalTests.csproj
       AIVE_COROS_FIT — the FIT file of the session of 2026-09-27 (default
       D:\Времянка для монтажа\Боулдер 27.09.2026\Болдеринг20260927100239.fit). A missing file fails the run. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AiVideoEditor.Telemetry.LocalTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <!-- C1: the import from disk and the summary the user sees. -->
    <ProjectReference Include="..\..\src\Media\Media.csproj" />
    <ProjectReference Include="..\..\src\UI\UI.csproj" />
    <!-- Step 35.3b1: the synchronisation study of the whole set (16 videos probed with ffprobe, every file hashed). -->
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Video\Video.csproj" />
    <ProjectReference Include="..\..\src\Project\Project.csproj" />
    <!-- Step 35.4's real-session rows (C1, C8, C12): the edit service behind the Inspector's alignment. -->
    <ProjectReference Include="..\..\src\Timeline\Timeline.csproj" />
  </ItemGroup>

</Project>
