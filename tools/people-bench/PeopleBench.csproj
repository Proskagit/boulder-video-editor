<Project Sdk="Microsoft.NET.Sdk">

  <!-- D061: the people analysis on real clips — the product's analyzer (Core/People) with the app's ffmpeg decoder and the
       installed people models (Vision), timed; the results as JSON for the benchmark report and the contact sheets. Not part
       of the solution or of any build of the application; the clips and every output stay outside the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AiVideoEditor.PeopleBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\Video\Video.csproj" />
    <ProjectReference Include="..\..\src\Vision\Vision.csproj" />
    <ProjectReference Include="..\..\src\Media\Media.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
