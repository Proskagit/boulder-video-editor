<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiVideoEditor.Vision</RootNamespace>
    <AssemblyName>AiVideoEditor.Vision</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- D034 §3: local inference through ONNX Runtime with the DirectML execution provider (MIT); the CPU provider is part
         of the same package (the fallback). The version matches the one the E1 reference masks were made with. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- The DirectML redistributable the DirectML execution provider is built against (Microsoft.AI.DirectML 1.15.4, a
       dependency of the package above). Its own targets copy it only for an explicit x64 / ARM64 PlatformTarget; this
       AnyCPU build copies the x64 library next to the application, so the operating system's older DirectML.dll is not
       picked up instead. On other architectures the system library is used (or the CPU fallback). -->
  <ItemGroup Condition="'$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)' != '' AND '$(PlatformTarget)' != 'x64' AND '$(OS)' == 'Windows_NT'">
    <None Include="$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vision.Tests" />
    <InternalsVisibleTo Include="Vision.ModelTests" />
  </ItemGroup>

</Project>
