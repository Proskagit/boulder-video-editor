<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiVideoEditor.Vision</RootNamespace>
    <AssemblyName>AiVideoEditor.Vision</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- D034 §3: local inference through ONNX Runtime with the DirectML execution provider (MIT); the CPU provider is part
         of the same package (the fallback). The version matches the one the E1 reference masks were made with. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- DirectML.dll itself is NOT shipped: the redistributable (Microsoft.AI.DirectML, a dependency of the package above)
       is under the Microsoft Software License Terms, not MIT (docs/AI_MODEL.md). This AnyCPU build never copies it (its
       targets copy only for an explicit PlatformTarget), so ONNX Runtime loads the operating system's DirectML.dll; if
       that fails, the service falls back to the CPU (D034 §3). -->

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vision.Tests" />
    <InternalsVisibleTo Include="Vision.ModelTests" />
  </ItemGroup>

</Project>
