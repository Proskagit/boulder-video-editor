<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiVideoEditor.Core</RootNamespace>
    <AssemblyName>AiVideoEditor.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions only (no logging provider) so the domain layer stays free of
         infrastructure concerns while still being able to accept ILogger<T>. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- D039: user-visible texts; English neutral, Russian satellite. MSBuild generates the strongly typed class (no package). -->
    <EmbeddedResource Update="Localization\Messages.resx" StronglyTypedFileName="$(IntermediateOutputPath)Messages.g.cs" StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="AiVideoEditor.Core.Localization" StronglyTypedClassName="Messages" PublicClass="true" />
  </ItemGroup>

</Project>
