<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="using:AiVideoEditor.UI.Views.Panels"
        xmlns:views="using:AiVideoEditor.UI.Views"
        xmlns:l="using:AiVideoEditor.UI.Localization"
        xmlns:controls="using:AiVideoEditor.UI.Controls"
        x:Class="AiVideoEditor.UI.Views.MainWindow"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        >

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,240,Auto">

    <!-- Toolbar -->
    <panels:ToolbarView Grid.Row="0" DataContext="{Binding Toolbar}"/>

    <!-- Media Browser | Preview | Inspector -->
    <Grid x:Name="PanelsGrid" Grid.Row="1" ColumnDefinitions="260,4,*,4,420">
      <panels:MediaBrowserView Grid.Column="0" DataContext="{Binding MediaBrowser}"/>
      <GridSplitter Grid.Column="1" Background="{DynamicResource DividerBrush}" ResizeDirection="Columns"/>
      <panels:PreviewView Grid.Column="2" DataContext="{Binding Preview}"/>
      <GridSplitter Grid.Column="3" Background="{DynamicResource DividerBrush}" ResizeDirection="Columns"/>
      <panels:InspectorView Grid.Column="4" DataContext="{Binding Inspector}"/>
    </Grid>

    <!-- Splitter between the main area and the Timeline -->
    <GridSplitter Grid.Row="2" Height="4" Background="{DynamicResource DividerBrush}" ResizeDirection="Rows"/>

    <!-- Timeline -->
    <panels:TimelineView Grid.Row="3" DataContext="{Binding Timeline}"/>

    <!-- D068 item 5: the start screen lies over the panels and the timeline (the tool bar stays usable) until a project is
         open or the new one changes. -->
    <views:StartScreenView x:Name="StartScreen" Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding StartScreen}"
                           IsVisible="{Binding IsVisible}"/>

    <!-- Status bar -->
    <!-- D039 §6: a long message is trimmed with an ellipsis; the whole of it is in the bar's tooltip. -->
    <!-- D060 §5: the export running in the background — its bar, its percentage and ✕; a click opens its window. -->
    <!-- D068 item 2: the bar is neutral (blue no longer means "just a message"). -->
    <Border Grid.Row="4" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,4" ToolTip.Tip="{Binding Status.Message}">
      <Grid ColumnDefinitions="*,Auto">
        <!-- D068 item 4: a warning (amber) or an error (red) has its icon and colour; an ordinary message is neutral. -->
        <StackPanel x:Name="StatusLine" Orientation="Horizontal" Spacing="6">
          <controls:IconPath x:Name="StatusWarningIcon" Glyph="{x:Static controls:Icons.Warning}" Stroke="{DynamicResource WarningBrush}"
                             IsVisible="{Binding Status.IsWarning}" VerticalAlignment="Center"/>
          <controls:IconPath x:Name="StatusErrorIcon" Glyph="{x:Static controls:Icons.Error}" Stroke="{DynamicResource DangerBrush}"
                             IsVisible="{Binding Status.IsError}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="{Binding Status.Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Classes.warning="{Binding Status.IsWarning}" Classes.error="{Binding Status.IsError}">
            <TextBlock.Styles>
              <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></Style>
              <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/></Style>
            </TextBlock.Styles>
          </TextBlock>
        </StackPanel>
        <StackPanel x:Name="ExportIndicator" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0"
                    IsVisible="{Binding IsExportActive}">
          <Button x:Name="ExportIndicatorButton" Command="{Binding ShowExportCommand}" Padding="6,0" MinHeight="0"
                  Background="Transparent" BorderThickness="0" ToolTip.Tip="{x:Static l:Strings.Export_CompactTip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar Width="120" Height="8" MinHeight="0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                           Value="{Binding ExportProgress.OverallPercent}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface3Brush}"/>
              <TextBlock Text="{Binding ExportProgress.CompactText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="ExportIndicatorCancel" Content="✕" Command="{Binding CancelExportCommand}" Padding="6,0" MinHeight="0"
                  Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" FontSize="{DynamicResource FontSizeCaption}"
                  ToolTip.Tip="{x:Static l:Strings.Export_CompactCancelTip}"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>

</Window>
