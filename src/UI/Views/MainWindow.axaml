<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="using:AiVideoEditor.UI.Views.Panels"
        x:Class="AiVideoEditor.UI.Views.MainWindow"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        Background="#1E1E1E">

  <Grid RowDefinitions="Auto,*,Auto,240,Auto">

    <!-- Toolbar -->
    <panels:ToolbarView Grid.Row="0" DataContext="{Binding Toolbar}"/>

    <!-- Media Browser | Preview | Inspector -->
    <Grid Grid.Row="1" ColumnDefinitions="260,4,*,4,300">
      <panels:MediaBrowserView Grid.Column="0" DataContext="{Binding MediaBrowser}"/>
      <GridSplitter Grid.Column="1" Background="#1A1A1A" ResizeDirection="Columns"/>
      <panels:PreviewView Grid.Column="2" DataContext="{Binding Preview}"/>
      <GridSplitter Grid.Column="3" Background="#1A1A1A" ResizeDirection="Columns"/>
      <panels:InspectorView Grid.Column="4" DataContext="{Binding Inspector}"/>
    </Grid>

    <!-- Splitter between the main area and the Timeline -->
    <GridSplitter Grid.Row="2" Height="4" Background="#1A1A1A" ResizeDirection="Rows"/>

    <!-- Timeline -->
    <panels:TimelineView Grid.Row="3" DataContext="{Binding Timeline}"/>

    <!-- Status bar -->
    <Border Grid.Row="4" Background="#007ACC" Padding="10,4">
      <TextBlock Text="{Binding Status.Message}" Foreground="White" FontSize="11"/>
    </Border>

  </Grid>

</Window>
