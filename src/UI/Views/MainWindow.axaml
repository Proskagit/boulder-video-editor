<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="using:AiVideoEditor.UI.Views.Panels"
        xmlns:l="using:AiVideoEditor.UI.Localization"
        x:Class="AiVideoEditor.UI.Views.MainWindow"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        Background="#1E1E1E">

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,240,Auto">

    <!-- Toolbar -->
    <panels:ToolbarView Grid.Row="0" DataContext="{Binding Toolbar}"/>

    <!-- Media Browser | Preview | Inspector -->
    <Grid x:Name="PanelsGrid" Grid.Row="1" ColumnDefinitions="260,4,*,4,360">
      <panels:MediaBrowserView Grid.Column="0" DataContext="{Binding MediaBrowser}"/>
      <GridSplitter Grid.Column="1" Background="#1A1A1A" ResizeDirection="Columns"/>
      <panels:PreviewView Grid.Column="2" DataContext="{Binding Preview}"/>
      <GridSplitter Grid.Column="3" Background="#1A1A1A" ResizeDirection="Columns"/>
      <panels:InspectorView Grid.Column="4" DataContext="{Binding Inspector}"/>
    </Grid>

    <!-- Splitter between the main area and the Timeline -->
    <GridSplitter Grid.Row="2" Height="4" Background="#1A1A1A" ResizeDirection="Rows"/>

    <!-- Timeline -->
    <panels:TimelineView Grid.Row="3" DataContext="{Binding Timeline}"/>

    <!-- Status bar -->
    <!-- D039 §6: a long message is trimmed with an ellipsis; the whole of it is in the bar's tooltip. -->
    <!-- D060 §5: the export running in the background — its bar, its percentage and ✕; a click opens its window. -->
    <Border Grid.Row="4" Background="#007ACC" Padding="10,4" ToolTip.Tip="{Binding Status.Message}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status.Message}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <StackPanel x:Name="ExportIndicator" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0"
                    IsVisible="{Binding IsExportActive}">
          <Button x:Name="ExportIndicatorButton" Command="{Binding ShowExportCommand}" Padding="6,0" MinHeight="0"
                  Background="Transparent" BorderThickness="0" ToolTip.Tip="{x:Static l:Strings.Export_CompactTip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar Width="120" Height="8" MinHeight="0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                           Value="{Binding ExportProgress.OverallPercent}" Foreground="White" Background="#3399DD"/>
              <TextBlock Text="{Binding ExportProgress.CompactText}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="ExportIndicatorCancel" Content="✕" Command="{Binding CancelExportCommand}" Padding="6,0" MinHeight="0"
                  Foreground="White" Background="Transparent" BorderThickness="0" FontSize="11"
                  ToolTip.Tip="{x:Static l:Strings.Export_CompactCancelTip}"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>

</Window>
