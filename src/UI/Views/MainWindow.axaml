<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="AiVideoEditor.UI.Views.MainWindow"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#1E1E1E">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Text="AI Video Editor" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      <TextBlock Text="— architecture skeleton (Phase 0)" FontSize="14" Foreground="#9A9A9A" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#9A9A9A" VerticalAlignment="Center"/>
    </StackPanel>

    <Border Background="#252526" CornerRadius="4" Padding="24">
      <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Media / Preview / Timeline / Inspector panels arrive in Phase 1."
                   Foreground="#CCCCCC" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Content="Increment demo counter" Command="{Binding IncrementDemoCommand}"/>
          <Button Content="Undo" Command="{Binding UndoCommand}"/>
          <TextBlock Text="{Binding DemoCounter}" Foreground="White" VerticalAlignment="Center" FontSize="18"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </DockPanel>

</Window>
