<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.ExportEncodingEditorView">

  <!-- D076: «Пресет» on top (the built-in presets, the user's saved ones, «Пользовательский», «＋ Сохранить пресет…»; ✕ deletes a
       saved one); «Подробные настройки» show every field of the chosen preset — the file type, the codec, the encoder, the
       resolution, the rate control, the quality or the bitrate, the speed and the sound; a change makes it «Пользовательский».
       Below: the parameters actually used, the speed and the codec's notes; the expected size and an NVENC / codec notice stay
       in view. -->
  <StackPanel Spacing="2">
    <StackPanel.Styles>
      <Style Selector="ComboBox.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10,0,0,6"/>
        <Setter Property="ItemTemplate">
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Detail}">
              <TextBlock Text="{Binding Label}"/>
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Setter>
      </Style>
    </StackPanel.Styles>

    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="0" Text="{x:Static l:Strings.ExportPreset_Label}" VerticalAlignment="Center"/>
      <ComboBox x:Name="ExportPresetBox" Grid.Column="1" Classes="choice" ToolTip.Tip="{x:Static l:Strings.ExportPreset_SavedTip}"
                ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
      <Button x:Name="DeletePresetButton" Grid.Column="2" Content="✕" Command="{Binding DeletePresetCommand}" IsVisible="{Binding IsSavedPreset}"
              ToolTip.Tip="{x:Static l:Strings.ExportPreset_DeleteTip}" Padding="8,2" Margin="6,0,0,6" VerticalAlignment="Center"/>
    </Grid>

    <!-- Q5 A: the name typed, a suggestion filled in. -->
    <Grid x:Name="SavePresetRow" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsSavingPreset}" Margin="0,0,0,6">
      <TextBox x:Name="PresetNameBox" Text="{Binding NewPresetName, Mode=TwoWay}" Watermark="{x:Static l:Strings.ExportPreset_Name}"/>
      <Button x:Name="SavePresetButton" Grid.Column="1" Classes="accent" Content="{x:Static l:Strings.ExportPreset_Save}" Command="{Binding SavePresetCommand}" Margin="6,0,0,0"/>
      <Button Grid.Column="2" Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelSavePresetCommand}" Margin="6,0,0,0"/>
    </Grid>

    <Expander x:Name="MoreSettings" Header="{x:Static l:Strings.ExportDialog_More}" IsExpanded="False" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Margin="0,2,0,4">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="{x:Static l:Strings.ExportContainer_Label}" VerticalAlignment="Center"/>
          <ComboBox x:Name="ContainerBox" Grid.Row="0" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"/>

          <TextBlock Grid.Row="1" Text="{x:Static l:Strings.ExportCodec_Label}" VerticalAlignment="Center"/>
          <ComboBox x:Name="CodecBox" Grid.Row="1" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding Codecs}" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}"/>

          <TextBlock Grid.Row="2" Text="{x:Static l:Strings.ExportEncoder_Label}" VerticalAlignment="Center"/>
          <ComboBox x:Name="EncoderBox" Grid.Row="2" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder, Mode=TwoWay}"/>

          <TextBlock Grid.Row="3" Text="{x:Static l:Strings.ExportResolution_Label}" VerticalAlignment="Center" ToolTip.Tip="{x:Static l:Strings.ExportResolution_Hint}"/>
          <ComboBox x:Name="ResolutionBox" Grid.Row="3" Grid.Column="1" Classes="choice" ToolTip.Tip="{x:Static l:Strings.ExportResolution_Hint}"
                    ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"/>

          <TextBlock Grid.Row="4" Text="{x:Static l:Strings.ExportRate_Label}" VerticalAlignment="Center"/>
          <ComboBox x:Name="RateControlBox" Grid.Row="4" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding RateControls}" SelectedItem="{Binding SelectedRateControl, Mode=TwoWay}"/>

          <TextBlock Grid.Row="5" Text="{x:Static l:Strings.Settings_Quality}" VerticalAlignment="Center" IsVisible="{Binding !IsBitrate}"/>
          <ComboBox x:Name="QualityBox" Grid.Row="5" Grid.Column="1" Classes="choice" IsVisible="{Binding !IsBitrate}"
                    ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"/>

          <TextBlock Grid.Row="6" Text="{x:Static l:Strings.ExportVideoBitrate_Label}" VerticalAlignment="Center" IsVisible="{Binding IsBitrate}"/>
          <ComboBox x:Name="VideoBitrateBox" Grid.Row="6" Grid.Column="1" Classes="choice" IsVisible="{Binding IsBitrate}"
                    ItemsSource="{Binding VideoBitrates}" SelectedItem="{Binding SelectedVideoBitrate, Mode=TwoWay}"/>

          <TextBlock Grid.Row="7" Text="{x:Static l:Strings.Settings_EncodingSpeed}" VerticalAlignment="Center"/>
          <ComboBox x:Name="SpeedBox" Grid.Row="7" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"/>

          <TextBlock Grid.Row="8" Text="{x:Static l:Strings.Settings_AudioBitrate}" VerticalAlignment="Center"/>
          <ComboBox x:Name="BitrateBox" Grid.Row="8" Grid.Column="1" Classes="choice"
                    ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}"/>
        </Grid>
        <TextBlock x:Name="EncoderDetailText" Text="{Binding SelectedEncoder.Detail}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Static l:Strings.ExportEncoder_Both}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlanText" Text="{Binding PlanText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock x:Name="SpeedNoteText" Text="{Binding SpeedNote}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="CodecNoteText" Text="{Binding CodecNote}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </Expander>

    <TextBlock x:Name="EstimateText" Text="{Binding EstimateText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
               IsVisible="{Binding EstimateText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <TextBlock x:Name="UnavailableText" Text="{Binding UnavailableNote}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
               IsVisible="{Binding UnavailableNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
