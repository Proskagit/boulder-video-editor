<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.Panels.MixerPanel"
             Width="380">

  <!-- D064 §1 / §3: the mixer — the master volume and every track's volume, M and S in one place; the comparison with the
       original sound (the Preview only). The DataContext is the timeline's MixerViewModel. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#C0C0C0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#E0E0E0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="ToggleButton.state">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="20"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6" Margin="4">
    <Grid ColumnDefinitions="110,*,70">
      <TextBlock Classes="label" FontWeight="Bold" Text="{x:Static l:Strings.Mixer_Master}"/>
      <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding MasterPercent, Mode=TwoWay}" SmallChange="1" LargeChange="10"
              ToolTip.Tip="{x:Static l:Strings.Mixer_MasterTip}"/>
      <TextBlock Grid.Column="2" Classes="value" Text="{Binding MasterText}"/>
    </Grid>
    <Rectangle Height="1" Fill="#3A3A3A"/>
    <ItemsControl ItemsSource="{Binding Tracks}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="80,26,26,*,64" Margin="0,2">
            <TextBlock Classes="label" Text="{Binding Name}"/>
            <ToggleButton Grid.Column="1" Classes="state" Content="M" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip.Tip="{x:Static l:Strings.Track_MuteTip}"/>
            <ToggleButton Grid.Column="2" Classes="state" Content="S" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip.Tip="{x:Static l:Strings.Track_SoloTip}"/>
            <Slider Grid.Column="3" Minimum="0" Maximum="200" Value="{Binding VolumePercent, Mode=TwoWay}" SmallChange="1" LargeChange="10" Margin="4,0"/>
            <TextBlock Grid.Column="4" Classes="value" Text="{Binding VolumeText}"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Rectangle Height="1" Fill="#3A3A3A"/>
    <CheckBox Content="{x:Static l:Strings.Mixer_OriginalSound}" IsChecked="{Binding OriginalSound, Mode=TwoWay}"
              ToolTip.Tip="{x:Static l:Strings.Mixer_OriginalSoundTip}"/>
    <TextBlock FontSize="10" Foreground="#9A9A9A" TextWrapping="Wrap" Text="{x:Static l:Strings.Mixer_Note}"/>
  </StackPanel>
</UserControl>
