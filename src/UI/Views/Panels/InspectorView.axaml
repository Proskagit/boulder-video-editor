<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.Panels.InspectorView">

  <Border Background="#252526" BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <TextBlock Text="INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A"/>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="10" Spacing="16">

          <!-- Nothing selected -->
          <TextBlock IsVisible="{Binding IsNothingSelected}"
                     Text="Nothing selected. Choose an item in the Media Browser or a clip on the timeline to see its properties."
                     Foreground="#6A6A6A" FontSize="11" TextWrapping="Wrap"/>

          <!-- Media Browser selection (Phase 2) -->
          <StackPanel IsVisible="{Binding IsMediaSelected}" Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="MEDIA" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Spacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="File Name" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFileName}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="Type" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaTypeLabel}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="Format" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFormatLabel}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="File Size" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFileSizeDisplay}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="Path" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFilePath}" Foreground="#DDDDDD" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#3A3A3A"/>

            <StackPanel Spacing="6">
              <TextBlock Text="TECHNICAL INFORMATION" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <TextBlock IsVisible="{Binding IsAnalyzing}"
                         Text="Analyzing…" Foreground="#8A8A8A" FontSize="11"/>

              <TextBlock IsVisible="{Binding HasAnalysisError}"
                         Text="{Binding AnalysisErrorMessage}"
                         Foreground="#D98A8A" FontSize="11" TextWrapping="Wrap"/>

              <ItemsControl IsVisible="{Binding HasTechnicalInfo}" ItemsSource="{Binding TechnicalRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Label}" Foreground="#7A7A7A" FontSize="10"/>
                      <TextBlock Text="{Binding Value}" Foreground="#DDDDDD"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- Timeline clip selection (Phase 4) -->
          <StackPanel IsVisible="{Binding IsTimelineClipSelected}" Spacing="16">
            <!-- Transform: scaffold only, hidden until it becomes editable in Phase 7. -->
            <StackPanel Spacing="6" IsVisible="False">
              <TextBlock Text="TRANSFORM" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Position X" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding PositionX}" Increment="1" FormatString="0.##" Width="140"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Position Y" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding PositionY}" Increment="1" FormatString="0.##" Width="140"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Scale" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding Scale}" Increment="0.05" FormatString="0.##" Width="140"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Rotation" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding Rotation}" Increment="1" FormatString="0.##" Width="140"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Opacity" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding Opacity}" Increment="0.05" Minimum="0" Maximum="1" FormatString="0.##" Width="140"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Audio (Phase 7): volume and mute are independent; every change is one edit. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasAudioProperties}">
              <TextBlock Text="AUDIO" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Volume" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding VolumePercent, Mode=TwoWay}" Increment="1"
                               Minimum="0" Maximum="200" FormatString="0.#" Width="110"/>
                <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Not focusable: Space stays Play/Pause instead of toggling the box after a click. -->
              <CheckBox Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" Focusable="False"
                        Margin="88,0,0,0" Foreground="#DDDDDD"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="CLIP" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Spacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="Source" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding ClipName}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Type" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ClipTypeLabel}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Start Time" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding StartTimeDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="End Time" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding EndTimeDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Duration" Width="80" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding DurationDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding ClipFrameRateDisplay, StringFormat='Timecode (non-drop-frame) at {0}'}"
                           Foreground="#6A6A6A" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
