<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:AiVideoEditor.UI.Common"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             xmlns:panels="using:AiVideoEditor.UI.ViewModels.Panels"
             x:Class="AiVideoEditor.UI.Views.Panels.InspectorView">

  <!-- The owner's acceptance of 2026-11-10: compact sections — a low header (Fluent's Expander is 48 px high) and little
       padding, so a collapsed Inspector takes little room. -->
  <UserControl.Resources>
    <x:Double x:Key="ExpanderMinHeight">28</x:Double>
    <Thickness x:Key="ExpanderHeaderPadding">10,0,8,0</Thickness>
    <Thickness x:Key="ExpanderContentPadding">10,4,8,6</Thickness>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Every numeric field: sign, digits and the decimal separator only (NumericInput). -->
    <Style Selector="NumericUpDown">
      <Setter Property="ParsingNumberStyle" Value="{x:Static common:NumericInput.ParsingStyle}"/>
    </Style>
    <!-- FU-25.1 / D079 §2: the numeric fields' arrows, padding and widths are the theme's (BoulderTheme). -->
    <!-- D039 §6: one label column for every field — wide enough for the Russian labels, a long one wraps instead of being cut. -->
    <Style Selector="TextBlock.label">
      <Setter Property="Width" Value="120"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- D061: a Follow / Occlusion state that needs the user (a pick, a failure, no room to move). -->
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
    </Style>
    <!-- D039 §8 / D040 §4: a slider under a bounded field (Opacity, Volume, Fade In / Out, the hold line width); the field keeps
         exact typing, a drag is one undo step (D017). FU-25.2: Opacity, Volume and the line width take whole values (their
         view models round a typed fraction, step 1); their «0.####» shows a whole value as whole and a fraction saved
         before as it is. -->
    <!-- Phase 27 (D043 §3): a colour swatch and a cell of the placement grid. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SmallControlCornerRadius}"/>
    </Style>
    <Style Selector="Button.swatch > Border">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.cell">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SmallControlCornerRadius}"/>
    </Style>
    <!-- D068 amendment 1 (as CapCut): the slider between the label and its field, on the field's line. -->
    <Style Selector="Slider.inline">
      <Setter Property="Width" Value="72"/>
      <Setter Property="Margin" Value="8,-12,8,-12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
    <Style Selector="ToggleButton.rail">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Margin" Value="3,2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <TextBlock Text="{x:Static l:Strings.Inspector_Heading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </Border>

      <!-- D068 item 8 / amendment 1: the rail of a single clip's groups on the left edge — navigation only: a button scrolls the
           list to its group; the group at the top is lit. -->
      <Border x:Name="InspectorRail" DockPanel.Dock="Left" Width="64" Background="{DynamicResource Surface0Brush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowsRail"/>
            <Binding Path="!IsHoldsOnly"/>
          </MultiBinding>
        </Border.IsVisible>
        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="panels:InspectorCategoryItem">
              <ToggleButton Classes="rail" IsVisible="{Binding IsAvailable}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding Select}" CommandParameter="{Binding Category}" ToolTip.Tip="{Binding Title}"
                            AutomationProperties.Name="{Binding Title}">
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                  <controls:IconPath Glyph="{Binding Glyph}" Width="18" Height="18" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <ScrollViewer x:Name="InspectorScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6" Spacing="3">

          <!-- Nothing selected -->
          <TextBlock IsVisible="{Binding IsNothingSelected}"
                     Text="{x:Static l:Strings.Inspector_NothingSelected}"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>

          <!-- Media Browser selection (Phase 2) -->
          <StackPanel IsVisible="{Binding IsMediaSelected}" Spacing="16">
            <controls:InspectorSection SectionId="media" Title="{x:Static l:Strings.Inspector_MediaHeading}">
              <StackPanel Spacing="6">

                <StackPanel Spacing="6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_FileName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding MediaFileName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Type}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding MediaTypeLabel}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Format}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding MediaFormatLabel}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding MediaFileSizeDisplay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding MediaFilePath}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>

            <Rectangle Height="1" Fill="#3A3A3A"/>

            <controls:InspectorSection SectionId="media.tech" CollapsedByDefault="False" Title="{x:Static l:Strings.Inspector_TechHeading}">
              <StackPanel Spacing="6">

                <TextBlock IsVisible="{Binding HasAnalysisStatusText}"
                           Text="{Binding AnalysisStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>

                <TextBlock IsVisible="{Binding HasAnalysisError}"
                           Text="{Binding AnalysisErrorMessage}"
                           Foreground="{DynamicResource DangerTextBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>

                <ItemsControl IsVisible="{Binding HasTechnicalInfo}" ItemsSource="{Binding TechnicalRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </controls:InspectorSection>
          </StackPanel>

          <!-- Dissolve selection (Phase 10, D025): its length in whole frames (2 … the longest that fits, from the edit
               service), the time next to it, Remove. Disabled while an export runs. -->
          <StackPanel IsVisible="{Binding IsTransitionSelected}" IsEnabled="{Binding IsEditingAllowed}" Spacing="6">
            <TextBlock Text="{Binding TransitionHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{Binding DissolveClipsDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <!-- The audio crossfade (D032 R9): its length in whole frames, as before. -->
            <StackPanel IsVisible="{Binding IsAudioTransitionSelected}" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding DissolveFrames, Mode=TwoWay}" Increment="1" Minimum="{Binding MinDissolveFrames}"
                               Maximum="{Binding MaxDissolveFrames}" FormatString="0"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding DissolveTimeDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,-4,0,0"/>
              <TextBlock Text="{Binding DissolveLimitDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Phase 28 (D044 §5–§6): a video transition — the type (one that cannot fit is disabled with the reason), a
                 push's direction, the duration in seconds stored as whole frames (the stored seconds and frames under it). -->
            <StackPanel x:Name="TransitionLibrarySection" IsVisible="{Binding IsVideoTransitionSelected}" Spacing="6">
              <!-- A toggle button checks itself on a click: IsChecked is two-way, so the view model's re-sync after a refused or
                   empty change unchecks it again (D8 of the Phase 28 run) — the buttons always show the model. -->
              <!-- The buttons wrap in the width left after the label column (a horizontal StackPanel gave them their own
                   width and pushed the section past the panel's edge at 300 px — the Phase 28 manual run, D1). -->
              <Grid ColumnDefinitions="144,*">
                <TextBlock Text="{x:Static l:Strings.Transition_Type}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <ItemsControl x:Name="TransitionTypeButtons" Grid.Column="1" ItemsSource="{Binding TransitionTypes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"
                                    ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" CommandParameter="{Binding TypeId}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4"
                                    Command="{Binding $parent[UserControl].DataContext.SetTransitionTypeCommand}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <Grid ColumnDefinitions="144,*" IsVisible="{Binding IsPushSelected}">
                <TextBlock Text="{x:Static l:Strings.Transition_Direction}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <ItemsControl x:Name="TransitionDirectionButtons" Grid.Column="1" ItemsSource="{Binding TransitionDirections}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Direction}"
                                    FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetTransitionDirectionCommand}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                <Slider Grid.Column="1" x:Name="TransitionSlider" Classes="inline" Focusable="False" TickFrequency="0.1"
                      Minimum="{Binding MinTransitionSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Maximum="{Binding MaxTransitionSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding TransitionSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_Duration}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                  <controls:CommitNumericUpDown Classes="wide" x:Name="TransitionSecondsField" Value="{Binding TransitionSeconds, Mode=TwoWay}" Increment="0.1"
                               StepCommand="{Binding StepTransitionSecondsCommand}"
                               Minimum="{Binding MinTransitionSeconds}" Maximum="{Binding MaxTransitionSeconds}" FormatString="0.##"/>
                  <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding TransitionDurationDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,-4,0,0"/>
              <TextBlock Text="{Binding TransitionLimitDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- A long label («Удалить перекрёстное затухание») wraps instead of passing the panel's edge (D1). -->
            <Button x:Name="RemoveTransitionButton" Command="{Binding RemoveDissolveCommand}" Margin="128,4,0,0" FontSize="{DynamicResource FontSizeCaption}">
              <TextBlock Text="{Binding RemoveTransitionLabel}" TextWrapping="Wrap"/>
            </Button>
          </StackPanel>

          <!-- D058 §3: several selected clips — five groups of properties, each applied to every clip it fits as one undo step;
               «—» (an empty field, no choice) where the clips differ. -->
          <StackPanel x:Name="GroupPanel" IsEnabled="{Binding IsEditingAllowed}" Spacing="3" DataContext="{Binding Group}"
                      IsVisible="{Binding IsActive}">
            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{x:Static l:Strings.Inspector_GroupHint}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static l:Strings.Inspector_GroupNothing}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding HasNothing}"/>
            <!-- D069 amendment 2 (the owner): the group's Inspector as a single clip's — the rail's groups and the same
                 collapsible sections. -->
            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection SectionId="group.frame" Title="{x:Static l:Strings.Inspector_FrameHeading}" IsVisible="{Binding HasClipSection}">
              <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasBackground}">
              <TextBlock Text="{x:Static l:Strings.Inspector_ClipBackground}" Classes="label"/>
              <ComboBox x:Name="GroupBackgroundBox" ItemsSource="{Binding Backgrounds}" SelectedIndex="{Binding BackgroundIndex, Mode=TwoWay}"
                        PlaceholderText="—" MinWidth="140"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFraming}">
              <TextBlock Text="{x:Static l:Strings.Inspector_GroupFrame}" Classes="label"/>
              <Button Content="{x:Static l:Strings.Frame_Fill}" Command="{Binding FillFrameCommand}"/>
              <Button Content="{x:Static l:Strings.Frame_Fit}" Command="{Binding FitFrameCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasOpacity}">
              <TextBlock Text="{x:Static l:Strings.Inspector_Opacity}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupOpacityBox" Value="{Binding OpacityPercent, Mode=TwoWay}" Increment="1"
                             Minimum="{Binding MinOpacityPercent}" Maximum="{Binding MaxOpacityPercent}" FormatString="0.####" Watermark="—"/>
              <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFades}">
              <TextBlock Text="{x:Static l:Strings.Inspector_FadeIn}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupFadeInBox" Value="{Binding FadeInFrames, Mode=TwoWay}" Increment="1"
                             Minimum="0" FormatString="0.####" Watermark="—"/>
              <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFades}">
              <TextBlock Text="{x:Static l:Strings.Inspector_FadeOut}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupFadeOutBox" Value="{Binding FadeOutFrames, Mode=TwoWay}" Increment="1"
                             Minimum="0" FormatString="0.####" Watermark="—"/>
              <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
            <Panel Classes="category" Tag="Holds">
            <controls:InspectorSection SectionId="group.holds" Title="{x:Static l:Strings.Inspector_GroupOutline}" IsVisible="{Binding HasHoldStyle}">
              <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Holds_Width}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupStrokeBox" Value="{Binding StrokeWidth, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinStrokeWidth}" Maximum="{Binding MaxStrokeWidth}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Holds_Colour}" Classes="label"/>
                <ComboBox x:Name="GroupColorBox" ItemsSource="{Binding ColorOptions}" SelectedIndex="{Binding ColorIndex, Mode=TwoWay}"
                          PlaceholderText="—" MinWidth="140">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" CornerRadius="2" Background="{Binding Hex}" IsVisible="{Binding Hex, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Holds_Keyline}" Classes="label"/>
                <ComboBox x:Name="GroupKeylineBox" ItemsSource="{Binding KeylineModes}" SelectedIndex="{Binding KeylineIndex, Mode=TwoWay}"
                          PlaceholderText="—" MinWidth="140"/>
              </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection SectionId="group.color" Title="{x:Static l:Strings.Inspector_ColorHeading}" IsVisible="{Binding HasColor}" ResetCommand="{Binding ResetColorCommand}">
              <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="128,0,0,0">
                <Button x:Name="GroupAutoEnhanceButton" Content="{x:Static l:Strings.Color_Auto}" Command="{Binding AutoEnhanceCommand}"
                        IsEnabled="{Binding !IsEnhancing}" ToolTip.Tip="{x:Static l:Strings.Color_AutoTip}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Exposure}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorExposureBox" Value="{Binding ColorExposure, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Brightness}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorBrightnessBox" Value="{Binding ColorBrightness, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Contrast}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorContrastBox" Value="{Binding ColorContrast, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Highlights}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorHighlightsBox" Value="{Binding ColorHighlights, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Shadows}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorShadowsBox" Value="{Binding ColorShadows, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Saturation}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorSaturationBox" Value="{Binding ColorSaturation, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Temperature}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorTemperatureBox" Value="{Binding ColorTemperature, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Color_Tint}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="GroupColorTintBox" Value="{Binding ColorTint, Mode=TwoWay}" Increment="1"
                               Minimum="{Binding MinColor}" Maximum="{Binding MaxColor}" FormatString="0.####" Watermark="—"/>
              </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
            <Panel Classes="category" Tag="Audio">
            <controls:InspectorSection SectionId="group.audio" Title="{x:Static l:Strings.Inspector_AudioHeading}" IsVisible="{Binding HasAudio}">
              <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudio}">
              <TextBlock Text="{x:Static l:Strings.Inspector_Volume}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupVolumeBox" Value="{Binding VolumePercent, Mode=TwoWay}" Increment="1"
                             Minimum="0" Maximum="200" FormatString="0.####" Watermark="—"/>
              <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <CheckBox x:Name="GroupMuteBox" Content="{x:Static l:Strings.Inspector_Mute}" IsThreeState="False" IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudio}">
              <TextBlock Text="{x:Static l:Strings.Inspector_NoiseReduction}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupNoiseBox" Value="{Binding NoiseReduction, Mode=TwoWay}" Increment="1"
                             Minimum="0" Maximum="{Binding MaxCleanup}" FormatString="0.####" Watermark="—"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudio}">
              <TextBlock Text="{x:Static l:Strings.Inspector_VoiceEnhancement}" Classes="label"/>
              <controls:CommitNumericUpDown x:Name="GroupVoiceBox" Value="{Binding VoiceEnhancement, Mode=TwoWay}" Increment="1"
                             Minimum="0" Maximum="{Binding MaxCleanup}" FormatString="0.####" Watermark="—"/>
            </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
          </StackPanel>

          <!-- Timeline clip selection (Phase 4); with a group of clips the group's Inspector above instead (D058 §3) -->
          <StackPanel IsVisible="{Binding IsSingleClipSelected}" IsEnabled="{Binding IsEditingAllowed}" Spacing="16">
            <!-- D062 amendment 1: a selected orange shows the «Зацепки» section alone. -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsHoldsOnly}">

            <!-- Transform and opacity (Phase 7): video, image and text clips. Every change is one edit;
                 consecutive changes of one field merge into one undo step. -->

            <!-- Crop (Phase 7): pictures only, fractions of the source per edge. -->
            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection SectionId="frame" ResetCommand="{Binding ResetFrameCommand}" Title="{x:Static l:Strings.Inspector_FrameHeading}">
              <controls:InspectorSection.IsVisible>
                <Binding Path="HasVisualProperties"/>
              </controls:InspectorSection.IsVisible>
              <StackPanel Spacing="10">
              <StackPanel Spacing="6" IsVisible="{Binding HasVisualProperties}">
                <TextBlock Text="{x:Static l:Strings.Inspector_TransformHeading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
              <StackPanel Spacing="6">
                <StackPanel Spacing="6">
                  <!-- Phase 27 (D043 §3, Q4): the 3 × 3 grid places a text's box at the safe margin, one undo step a cell; the X /
                       Y fields and the free move in the Preview stay. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTextProperties}">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Placement}" Classes="label"/>
                    <UniformGrid x:Name="PlacementGrid" Rows="3" Columns="3">
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Left" ToolTip.Tip="{x:Static l:Strings.Grid_TopLeft}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_TopCentre}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Right" ToolTip.Tip="{x:Static l:Strings.Grid_TopRight}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Left" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleLeft}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleCentre}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Right" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleRight}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Left" ToolTip.Tip="{x:Static l:Strings.Grid_BottomLeft}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_BottomCentre}"/>
                      <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Right" ToolTip.Tip="{x:Static l:Strings.Grid_BottomRight}"/>
                    </UniformGrid>
                  </StackPanel>
                  <!-- D063 §2: the keyframes at the playhead — whose, how many; add / remove on the frame; previous / next; the
                       easing to the next keyframe. -->
                  <StackPanel x:Name="KeyframeSection" Spacing="4" IsVisible="{Binding HasKeyframeSection}">
                    <!-- D068 amendment 1: the label centred on its two lines, the three buttons always on one line. -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" Text="{x:Static l:Strings.Inspector_Keyframes}" Classes="label" VerticalAlignment="Center"/>
                      <TextBlock x:Name="KeyframeOwnerText" Grid.Column="1" Text="{Binding KeyframeOwnerText}" FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,0,0,4"/>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                        <Button Content="◀" Command="{Binding PreviousKeyframeCommand}" FontSize="{DynamicResource FontSizeCaption}"
                                ToolTip.Tip="{x:Static l:Strings.Keyframe_PreviousTip}"/>
                        <Button x:Name="KeyframeToggleButton" Content="{Binding KeyframeButtonText}" Command="{Binding ToggleKeyframeHereCommand}"
                                IsEnabled="{Binding IsEditingAllowed}" FontSize="{DynamicResource FontSizeCaption}" ToolTip.Tip="{x:Static l:Strings.Timeline_KeyframeTip}"/>
                        <Button Content="▶" Command="{Binding NextKeyframeCommand}" FontSize="{DynamicResource FontSizeCaption}"
                                ToolTip.Tip="{x:Static l:Strings.Keyframe_NextTip}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOnKeyframe}">
                      <TextBlock Text="{x:Static l:Strings.Keyframe_Easing}" Classes="label"/>
                      <ComboBox x:Name="KeyframeEasingBox" ItemsSource="{Binding KeyframeEasings}" SelectedIndex="{Binding KeyframeEasingIndex, Mode=TwoWay}"
                                IsEnabled="{Binding IsEditingAllowed}" ToolTip.Tip="{x:Static l:Strings.Keyframe_EasingTip}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_PositionX}" Classes="label" Target="{Binding #PositionXBox}" StepPerPixel="1"
                                         ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                    <controls:CommitNumericUpDown Classes="wide" x:Name="PositionXBox" Value="{Binding PositionX, Mode=TwoWay}" Increment="1" Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}"
                                   FormatString="0.##"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_PositionY}" Classes="label" Target="{Binding #PositionYBox}" StepPerPixel="1"
                                         ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                    <controls:CommitNumericUpDown Classes="wide" x:Name="PositionYBox" Value="{Binding PositionY, Mode=TwoWay}" Increment="1" Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}"
                                   FormatString="0.##"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_Scale}" Classes="label" Target="{Binding #ScaleBox}" StepPerPixel="0.5"
                                         ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                    <controls:CommitNumericUpDown Classes="wide" x:Name="ScaleBox" Value="{Binding ScalePercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinScalePercent}" Maximum="{Binding MaxScalePercent}"
                                   FormatString="0.##"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <!-- Fill / Fit (Phase 26, D041 §2): a one-off Scale for a video or image clip. -->
                  <WrapPanel x:Name="FramingButtons" Orientation="Horizontal" Margin="128,0,0,0" IsVisible="{Binding HasCrop}">
                    <Button Content="{x:Static l:Strings.Frame_Fill}" Command="{Binding FillFrameCommand}" IsEnabled="{Binding IsEditingAllowed}"
                            FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Frame_FillTip}"/>
                    <Button Content="{x:Static l:Strings.Frame_Fit}" Command="{Binding FitFrameCommand}" IsEnabled="{Binding IsEditingAllowed}"
                            FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Frame_FitTip}"/>
                  </WrapPanel>
                  <!-- D057 §3.7: the canvas around the picture — black or the picture blurred (Preview = export). -->
                  <StackPanel x:Name="BackgroundRow" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasBackground}">
                    <TextBlock Text="{x:Static l:Strings.Inspector_ClipBackground}" Classes="label"/>
                    <ComboBox x:Name="BackgroundBox" ItemsSource="{Binding Backgrounds}" SelectedIndex="{Binding BackgroundIndex, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditingAllowed}" ToolTip.Tip="{x:Static l:Strings.Inspector_ClipBackgroundTip}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_Rotation}" Classes="label" Target="{Binding #RotationBox}" StepPerPixel="0.5"
                                         ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                    <controls:CommitNumericUpDown Classes="wide" x:Name="RotationBox" Value="{Binding Rotation, Mode=TwoWay}" Increment="1" Minimum="{Binding MinRotation}" Maximum="{Binding MaxRotation}"
                                   FormatString="0.##"/>
                    <TextBlock Text="°" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_Opacity}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="OpacitySlider" Classes="inline" TickFrequency="5" Focusable="False" Minimum="{Binding MinOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding OpacityPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_Opacity}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding OpacityPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinOpacityPercent}" Maximum="{Binding MaxOpacityPercent}"
                                   FormatString="0.####"/>
                      <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasCrop}">
                <TextBlock Text="{x:Static l:Strings.Inspector_CropHeading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
              <StackPanel Spacing="6">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Left}" Classes="label"/>
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding CropLeftPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                   FormatString="0.#"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Top}" Classes="label"/>
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding CropTopPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                   FormatString="0.#"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Right}" Classes="label"/>
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding CropRightPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                   FormatString="0.#"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Bottom}" Classes="label"/>
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding CropBottomPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                   FormatString="0.#"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- Template (Phase 29, D045 §6): only the template's own fields. A typed field applies live and merges with the
                 next change of the same field; a status or a colour is one click, one undo step. -->
            <Panel Classes="category" Tag="Text">
            <controls:InspectorSection SectionId="template" CollapsedByDefault="False" Title="{x:Static l:Strings.Inspector_TemplateHeading}" IsVisible="{Binding HasTemplate}">
              <StackPanel x:Name="TemplateSection" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsTemplateDate}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_TemplateDate}" Classes="label"/>
                  <TextBox x:Name="TemplateDateField" Text="{Binding TemplateDate, Mode=TwoWay}" MaxLength="{Binding MaxTemplateDateLength}" Width="150"/>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding ShowsTemplateBoulder}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateRoute}" Classes="label"/>
                    <TextBox x:Name="TemplateRouteField" Text="{Binding TemplateRoute, Mode=TwoWay}" MaxLength="{Binding MaxTemplateRouteLength}" Width="110"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateGrade}" Classes="label"/>
                    <TextBox x:Name="TemplateGradeField" Text="{Binding TemplateGrade, Mode=TwoWay}" MaxLength="{Binding MaxTemplateGradeLength}" Width="110"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="144,*">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateStatus}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <ItemsControl x:Name="TemplateStatusButtons" Grid.Column="1" ItemsSource="{Binding TemplateStatuses}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Status}"
                                        FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetTemplateStatusCommand}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <!-- D073: the stated attempts (empty: counted from the video). -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateAttempts}" Classes="label"/>
                    <TextBox x:Name="TemplateAttemptsField" Text="{Binding TemplateAttemptsText, Mode=TwoWay}" MaxLength="2" Width="110"
                             Watermark="{x:Static l:Strings.Inspector_TemplateAttemptsHint}" ToolTip.Tip="{x:Static l:Strings.Inspector_TemplateAttemptsTip}"/>
                  </StackPanel>
                  <!-- D045 §17: the moment the status appears — set from the playhead. -->
                  <Grid ColumnDefinitions="144,*" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowsTemplateStatusAt}">
                    <TextBlock Text="{x:Static l:Strings.TemplateStatusAt_Label}" Classes="label" VerticalAlignment="Center"/>
                    <Button x:Name="TemplateStatusAtButton" Grid.Column="1" HorizontalAlignment="Left" FontSize="{DynamicResource FontSizeCaption}"
                            Content="{x:Static l:Strings.TemplateStatusAt_Set}" ToolTip.Tip="{x:Static l:Strings.TemplateStatusAt_Tip}"
                            Command="{Binding SetTemplateStatusAtPlayheadCommand}"/>
                    <TextBlock x:Name="TemplateStatusAtText" Grid.Row="1" Grid.Column="1" Text="{Binding TemplateStatusAtText}"
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateAccent}" Classes="label"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding TemplateAccentHex}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="TemplateAccentSwatches" ItemsSource="{Binding RouteSwatches}" Margin="128,-2,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetTemplateAccentCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- D063 §C: the route plate's corner (the heart rate in the same corner stands beside it, nearer the centre). -->
                  <Grid ColumnDefinitions="144,*">
                    <TextBlock Text="{x:Static l:Strings.Inspector_PlateCorner}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <ItemsControl x:Name="PlateCornersButtons" Grid.Column="1" ItemsSource="{Binding PlateCorners}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Value}"
                                        FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetPlateCornerCommand}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <!-- D055 §5: the area's own heart rate — shown or not; its look, corner and colour below. -->
                  <CheckBox x:Name="TemplateShowHeartRateBox" Content="{x:Static l:Strings.Inspector_AreaShowHeartRate}"
                            IsChecked="{Binding TemplateShowHeartRate, Mode=TwoWay}" ToolTip.Tip="{x:Static l:Strings.Inspector_AreaShowHeartRateTip}"/>
                </StackPanel>
                <!-- D073: «Итоги» — the header, the date, its own background. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowsTemplateSummary}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_SummaryTitle}" Classes="label"/>
                    <TextBox x:Name="SummaryTitleField" Text="{Binding TemplateTitle, Mode=TwoWay}" MaxLength="{Binding MaxTemplateTitleLength}" Width="180"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_SummaryDate}" Classes="label"/>
                    <TextBox x:Name="SummaryDateField" Text="{Binding TemplateSubtitle, Mode=TwoWay}" MaxLength="{Binding MaxTemplateSubtitleLength}" Width="180"/>
                  </StackPanel>
                  <CheckBox x:Name="SummaryOwnBackgroundBox" Content="{x:Static l:Strings.Inspector_SummaryOwnBackground}"
                            IsChecked="{Binding TemplateOwnBackground, Mode=TwoWay}" ToolTip.Tip="{x:Static l:Strings.Inspector_SummaryOwnBackgroundTip}"/>
                  <TextBlock Text="{x:Static l:Strings.Inspector_SummaryHint}" Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                  <!-- D074 amendment 1: the attempts of each route, stated here (on the route's «Боулдер»). -->
                  <TextBlock Text="{x:Static l:Strings.Inspector_SummaryAttempts}" Classes="label" IsVisible="{Binding HasSummaryAttempts}" Margin="0,6,0,0"
                             ToolTip.Tip="{x:Static l:Strings.Inspector_SummaryAttemptsTip}"/>
                  <ItemsControl x:Name="SummaryAttemptsList" ItemsSource="{Binding SummaryAttempts}" IsVisible="{Binding HasSummaryAttempts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,64" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{Binding ResultText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                                     VerticalAlignment="Center" Margin="8,0"/>
                          <TextBox Grid.Column="2" Text="{Binding AttemptsText, Mode=TwoWay}" Watermark="{Binding Counted}" IsEnabled="{Binding IsEditable}"
                                   MaxLength="2" ToolTip.Tip="{x:Static l:Strings.Inspector_SummaryAttemptsTip}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- D073: the language of the words drawn by «Боулдер» and «Итоги». -->
                <Grid ColumnDefinitions="144,*" IsVisible="{Binding ShowsTemplateLanguage}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_TemplateLanguage}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                  <ItemsControl x:Name="TemplateLanguageButtons" Grid.Column="1" ItemsSource="{Binding TemplateLanguages}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Value}"
                                      FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetTemplateLanguageCommand}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding ShowsTemplateHighlight}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateTitle}" Classes="label"/>
                    <TextBox x:Name="TemplateTitleField" Text="{Binding TemplateTitle, Mode=TwoWay}" MaxLength="{Binding MaxTemplateTitleLength}" Width="180"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_TemplateSubtitle}" Classes="label"/>
                    <TextBox x:Name="TemplateSubtitleField" Text="{Binding TemplateSubtitle, Mode=TwoWay}" MaxLength="{Binding MaxTemplateSubtitleLength}" Width="180"/>
                  </StackPanel>
                </StackPanel>
                <!-- Phase 35.5: the heart-rate overlay — its look, its corner and its heart's colour, each one click, one undo step. -->
                <StackPanel x:Name="HeartRateSection" Spacing="6" IsVisible="{Binding ShowsHeartRateSettings}">
                  <Grid ColumnDefinitions="144,*">
                    <TextBlock Text="{x:Static l:Strings.Inspector_HeartRateLook}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <ItemsControl x:Name="HeartRateLooksButtons" Grid.Column="1" ItemsSource="{Binding HeartRateLooks}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Value}"
                                        FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetHeartRateLookCommand}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Grid ColumnDefinitions="144,*">
                    <TextBlock Text="{x:Static l:Strings.Inspector_HeartRateCorner}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <ItemsControl x:Name="HeartRateCornersButtons" Grid.Column="1" ItemsSource="{Binding HeartRateCorners}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Value}"
                                        FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetHeartRateCornerCommand}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_HeartRateColour}" Classes="label"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding TemplateHeartHex}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="HeartRateColourSwatches" ItemsSource="{Binding RouteSwatches}" Margin="128,-2,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetHeartColourCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="HeartRateHint" Text="{Binding HeartRateHint}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
            <!-- Text (Phase 7 Step 8): text clips only. Every field applies live; consecutive changes of one
                 field merge into one undo step. The color applies once it is a complete #RRGGBB. -->
            <Panel Classes="category" Tag="Text">
            <controls:InspectorSection SectionId="text" Title="{x:Static l:Strings.Inspector_TextHeading}" IsVisible="{Binding HasTextProperties}">
              <StackPanel Spacing="6">
                <TextBox Text="{Binding TextContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="160"/>
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Font}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamilyName, Mode=TwoWay}" Width="180"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_Size}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="FontSizeSlider" Classes="inline" Focusable="False"
                          Minimum="{Binding MinFontSize, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxFontSize, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding FontSize, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_Size}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding FontSize, Mode=TwoWay}" Increment="1" Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}"
                                   FormatString="0.##"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Color}" Classes="label"/>
                    <TextBox Text="{Binding TextColorHex, Mode=TwoWay}" Width="110" MaxLength="7"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding TextColorSwatch}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <!-- Phase 27 (D043 §3): a swatch is one click, one undo step; the field above stays for any colour. -->
                  <ItemsControl x:Name="TextColorSwatches" ItemsSource="{Binding Swatches}" Margin="128,-2,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetTextColorCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="128,0,0,0">
                    <CheckBox Content="{x:Static l:Strings.Inspector_Bold}" IsChecked="{Binding IsBold, Mode=TwoWay}"/>
                    <!-- D075 amendment 1: italic. -->
                    <CheckBox x:Name="ItalicToggle" Content="{x:Static l:Strings.Inspector_Italic}" IsChecked="{Binding IsItalic, Mode=TwoWay}"/>
                  </StackPanel>
                  <!-- D075 amendment 1: the line spacing and the block's width (also dragged in the Preview). -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_LineSpacing}" Classes="label"/>
                    <controls:CommitNumericUpDown Classes="wide" x:Name="LineSpacingField" Value="{Binding LineSpacing, Mode=TwoWay}" Increment="0.1"
                                 Minimum="{Binding MinLineSpacing}" Maximum="{Binding MaxLineSpacing}" FormatString="0.##"
                                 ToolTip.Tip="{x:Static l:Strings.Inspector_LineSpacingTip}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_BoxWidth}" Classes="label"/>
                    <TextBox x:Name="BoxWidthField" Text="{Binding BoxWidthText, Mode=TwoWay}" Watermark="{x:Static l:Strings.Inspector_BoxWidthAuto}"
                             Width="80" ToolTip.Tip="{x:Static l:Strings.Inspector_BoxWidthTip}"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Alignment}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment, Mode=TwoWay}" Width="150">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={x:Static l:AlignmentText.Instance}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!-- Phase 27 (D043 §2, Q3): the outline and the background, each switched and set on its own (values kept
                       while off); the switch and a swatch one undo step each, the thickness / opacity merge (D017). -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Outline}" Classes="label"/>
                    <CheckBox x:Name="OutlineToggle" IsChecked="{Binding IsOutlineOn, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding OutlineColorSwatch}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="OutlineColorSwatches" ItemsSource="{Binding Swatches}" Margin="128,-2,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetOutlineColorCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_OutlineThickness}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="OutlineThicknessSlider" Classes="inline" Focusable="False"
                          Minimum="{Binding MinOutlineThicknessPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxOutlineThicknessPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding OutlineThicknessPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_OutlineThicknessTip}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding OutlineThicknessPercent, Mode=TwoWay}" Increment="1"
                                   Minimum="{Binding MinOutlineThicknessPercent}" Maximum="{Binding MaxOutlineThicknessPercent}"
                                   FormatString="0.####" ToolTip.Tip="{x:Static l:Strings.Inspector_OutlineThicknessTip}"/>
                      <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Background}" Classes="label"/>
                    <CheckBox x:Name="BackgroundToggle" IsChecked="{Binding IsBackgroundOn, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding BackgroundColorSwatch}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="BackgroundColorSwatches" ItemsSource="{Binding Swatches}" Margin="128,-2,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetBackgroundColorCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_BackgroundOpacity}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="BackgroundOpacitySlider" Classes="inline" TickFrequency="5" Focusable="False"
                          Minimum="{Binding MinBackgroundOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxBackgroundOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding BackgroundOpacityPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_BackgroundOpacity}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding BackgroundOpacityPercent, Mode=TwoWay}" Increment="1"
                                   Minimum="{Binding MinBackgroundOpacityPercent}" Maximum="{Binding MaxBackgroundOpacityPercent}"
                                   FormatString="0.####"/>
                      <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <!-- D075 amendment 1: «Тень» — on / off, its colour, opacity, softness and offset. -->
                <StackPanel x:Name="ShadowPanel" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Shadow}" Classes="label"/>
                    <CheckBox x:Name="ShadowToggle" IsChecked="{Binding IsShadowOn, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"/>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding ShadowColorSwatch}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl x:Name="ShadowColorSwatches" ItemsSource="{Binding Swatches}" Margin="128,-2,0,0" IsVisible="{Binding IsShadowOn}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                                Command="{Binding $parent[UserControl].DataContext.SetShadowColorCommand}">
                          <Border Background="{Binding Hex}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="6" IsVisible="{Binding IsShadowOn}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Static l:Strings.Inspector_ShadowOpacity}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="ShadowOpacityField" Value="{Binding ShadowOpacityPercent, Mode=TwoWay}" Increment="5"
                                   Minimum="0" Maximum="100" FormatString="0.#"/>
                      <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Static l:Strings.Inspector_ShadowBlur}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="ShadowBlurField" Value="{Binding ShadowBlurPercent, Mode=TwoWay}" Increment="1"
                                   Minimum="0" Maximum="{Binding MaxShadowBlurPercent}" FormatString="0.#"/>
                      <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{x:Static l:Strings.Inspector_ShadowOffsetTip}">
                      <TextBlock Text="{x:Static l:Strings.Inspector_ShadowOffset}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="ShadowOffsetXField" Value="{Binding ShadowOffsetXPercent, Mode=TwoWay}" Increment="1"
                                   Minimum="{Binding MinShadowOffsetPercent}" Maximum="{Binding MaxShadowOffsetPercent}" FormatString="0.#"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="ShadowOffsetYField" Value="{Binding ShadowOffsetYPercent, Mode=TwoWay}" Increment="1"
                                   Minimum="{Binding MinShadowOffsetPercent}" Maximum="{Binding MaxShadowOffsetPercent}" FormatString="0.#"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <!-- D075 amendment 2: the styles as one list — «По умолчанию», the saved styles, «＋ Сохранить новый стиль…»; ✕ deletes the
                     chosen saved style. -->
                <StackPanel x:Name="TextStylesPanel" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSavedStyleStore}"
                            ToolTip.Tip="{x:Static l:Strings.Inspector_TextStylesTip}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_TextStyles}" Classes="label"/>
                  <ComboBox x:Name="TextStyleList" ItemsSource="{Binding StyleChoices}" SelectedItem="{Binding SelectedStyleChoice, Mode=TwoWay}" Width="190">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="DeleteTextStyleButton" Content="✕" Padding="6,2" ToolTip.Tip="{x:Static l:Strings.Inspector_DeleteTextStyle}"
                          Command="{Binding DeleteSelectedTextStyleCommand}"/>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- Phase 27 (D043 §1, Q1–Q2): a text's appearance and disappearance — the kind and its duration, which is the
                 clip's fade (stored in whole frames, D025); a kind or a direction is one undo step, a duration merges. -->
            <Panel Classes="category" Tag="Text">
            <controls:InspectorSection SectionId="text.animation" Title="{x:Static l:Strings.Inspector_AnimationHeading}" IsVisible="{Binding HasTextProperties}">
              <StackPanel x:Name="TextAnimationSection" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Appear}" Classes="label"/>
                  <ComboBox x:Name="AppearKind" ItemsSource="{Binding AppearanceKinds}" SelectedIndex="{Binding AppearKindIndex, Mode=TwoWay}" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAppearSlide}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_MotionSide}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding MotionSides}" SelectedIndex="{Binding AppearSideIndex, Mode=TwoWay}" Width="150"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsAppearTimed}">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_MotionDuration}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="AppearSlider" Classes="inline" Focusable="False" TickFrequency="0.1" IsVisible="{Binding IsAppearTimed}"
                        Minimum="{Binding MinAppearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxAppearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding AppearSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_Appear}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding AppearSeconds, Mode=TwoWay}" Increment="0.1" Minimum="{Binding MinAppearSeconds}"
                                 Maximum="{Binding MaxAppearSeconds}" FormatString="0.##"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <TextBlock IsVisible="{Binding IsFadeInInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Disappear}" Classes="label"/>
                  <ComboBox x:Name="DisappearKind" ItemsSource="{Binding AppearanceKinds}" SelectedIndex="{Binding DisappearKindIndex, Mode=TwoWay}" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDisappearSlide}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_MotionSide}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding MotionSides}" SelectedIndex="{Binding DisappearSideIndex, Mode=TwoWay}" Width="150"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsDisappearTimed}">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_MotionDuration}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="DisappearSlider" Classes="inline" Focusable="False" TickFrequency="0.1" IsVisible="{Binding IsDisappearTimed}"
                        Minimum="{Binding MinDisappearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxDisappearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding DisappearSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_Disappear}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Classes="wide" Value="{Binding DisappearSeconds, Mode=TwoWay}" Increment="0.1" Minimum="{Binding MinDisappearSeconds}"
                                 Maximum="{Binding MaxDisappearSeconds}" FormatString="0.##"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <TextBlock IsVisible="{Binding IsFadeOutInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- D061: Follow (the frame follows the chosen climber at the clip's scale) and the outlines hidden behind people
                 (Occlusion): one undo step per change; the analysis runs in the background with its progress, cancel and retry. -->
            <Panel Classes="category" Tag="People">
            <controls:InspectorSection SectionId="people" Title="{x:Static l:Strings.Inspector_PeopleHeading}">
              <controls:InspectorSection.IsVisible>
                <Binding Path="HasPeopleSection"/>
              </controls:InspectorSection.IsVisible>
              <StackPanel x:Name="PeoplePanel" Spacing="6">
                <!-- D068 item 8: the switch first, «следить отсюда» after it. -->
                <CheckBox x:Name="FollowToggle" Content="{x:Static l:Strings.Inspector_Follow}" IsChecked="{Binding FollowEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsEditingAllowed}" ToolTip.Tip="{x:Static l:Strings.Inspector_FollowTip}"/>
                <!-- D061 amendment 1: Follow from the playhead while the timeline plays, ended where the user stops it. -->
                <Button x:Name="FollowFromHereButton" Content="{x:Static l:Strings.Inspector_FollowFromHere}" Command="{Binding FollowFromHereCommand}"
                        IsVisible="{Binding !IsRecordingFollow}" IsEnabled="{Binding IsEditingAllowed}" FontSize="{DynamicResource FontSizeCaption}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_FollowFromHereTip}"/>
                <Button x:Name="StopFollowHereButton" Content="{x:Static l:Strings.Inspector_StopFollowHere}" Command="{Binding StopFollowHereCommand}"
                        IsVisible="{Binding IsRecordingFollow}" FontSize="{DynamicResource FontSizeCaption}" Classes="accent"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_StopFollowHereTip}"/>
                <StackPanel Spacing="6" IsVisible="{Binding FollowEnabled}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_FollowSmoothness}" Classes="label"/>
                    <ComboBox x:Name="FollowSmoothnessBox" ItemsSource="{Binding FollowSmoothnessNames}" SelectedIndex="{Binding FollowSmoothnessIndex, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditingAllowed}"/>
                  </StackPanel>
                  <!-- D061 amendment 1: where the climber stands in the frame (the part under the playhead); or drag the frame in the Preview. -->
                  <StackPanel Spacing="4" IsVisible="{Binding HasFollowOffset}" ToolTip.Tip="{x:Static l:Strings.Inspector_FollowOffsetTip}">
                    <TextBlock Text="{x:Static l:Strings.Inspector_FollowOffset}" Classes="label"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_PositionX}" Classes="label" Target="{Binding #FollowOffsetXBox}" StepPerPixel="1"
                                           ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="FollowOffsetXBox" Value="{Binding FollowOffsetX, Mode=TwoWay}" Increment="1"
                                                    Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}" FormatString="0.##"
                                                    IsEnabled="{Binding IsEditingAllowed}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:ScrubLabel Text="{x:Static l:Strings.Inspector_PositionY}" Classes="label" Target="{Binding #FollowOffsetYBox}" StepPerPixel="1"
                                           ToolTip.Tip="{x:Static l:Strings.Inspector_ScrubTip}"/>
                      <controls:CommitNumericUpDown Classes="wide" x:Name="FollowOffsetYBox" Value="{Binding FollowOffsetY, Mode=TwoWay}" Increment="1"
                                                    Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}" FormatString="0.##"
                                                    IsEnabled="{Binding IsEditingAllowed}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="PickPersonButton" Content="{x:Static l:Strings.Inspector_PickPerson}" Command="{Binding PickPersonCommand}"
                            FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Inspector_PickPersonTip}"/>
                    <Button Content="{x:Static l:Strings.Inspector_CancelPick}" Command="{Binding CancelPickPersonCommand}"
                            IsVisible="{Binding IsPickingPerson}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4"/>
                  </WrapPanel>
                  <TextBlock x:Name="FollowStatus" Text="{Binding FollowStatusText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                             Classes.problem="{Binding FollowStatusIsProblem}"/>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock x:Name="FollowRange" Text="{Binding FollowRangeText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <Button x:Name="FollowWholeClipButton" Content="{x:Static l:Strings.Inspector_FollowWholeClip}" Command="{Binding FollowWholeClipCommand}"
                            IsVisible="{Binding HasFollowRange}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4"/>
                    <Button x:Name="DeleteFollowPartButton" Content="{x:Static l:Strings.Inspector_DeleteFollowPart}" Command="{Binding DeleteFollowPartCommand}"
                            IsVisible="{Binding HasFollowPartHere}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Inspector_DeleteFollowPartTip}"/>
                  </WrapPanel>
                </StackPanel>
                <CheckBox x:Name="OcclusionToggle" Content="{x:Static l:Strings.Inspector_HideOutlinesBehindPeople}"
                          IsChecked="{Binding HidesOutlinesBehindPeople, Mode=TwoWay}" IsEnabled="{Binding IsEditingAllowed}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_HideOutlinesTip}"/>
                <StackPanel Spacing="6" IsVisible="{Binding HidesOutlinesBehindPeople}">
                  <TextBlock x:Name="OcclusionStatus" Text="{Binding OcclusionStatusText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                             Classes.problem="{Binding OcclusionStatusIsProblem}"/>
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding IsPeopleAnalysing}">
                  <ProgressBar x:Name="PeopleProgress" Minimum="0" Maximum="100" Value="{Binding PeopleProgressPercent}" Height="4" MinHeight="4"/>
                  <Button Content="{x:Static l:Strings.Inspector_CancelPeopleAnalysis}" Command="{Binding CancelPeopleAnalysisCommand}" FontSize="{DynamicResource FontSizeCaption}"/>
                </StackPanel>
                <Button x:Name="RetryPeopleButton" Content="{x:Static l:Strings.Inspector_RetryPeopleAnalysis}" Command="{Binding RetryPeopleAnalysisCommand}"
                        IsVisible="{Binding CanRetryPeopleAnalysis}" FontSize="{DynamicResource FontSizeCaption}"/>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            </StackPanel>

            <!-- Holds (Phase 19, D034): video clips only. The AI markup of the route on this clip and the outline's
                 style; every change is one undo step (consecutive changes of one field merge). -->
            <!-- D068 amendment 1: the rail's «Зацепки» (a selected orange shows it alone, D062 amendment 1). -->
            <Panel Classes="category" Tag="Holds">
            <controls:InspectorSection x:Name="HoldsSection" SectionId="holds" Title="{x:Static l:Strings.Inspector_HoldsHeading}" Summary="{Binding HoldMarkup.HoldCount, FallbackValue={x:Null}}" IsVisible="{Binding HoldMarkup.HasClip, FallbackValue=False}">
              <StackPanel Spacing="6">
                <StackPanel Spacing="6" DataContext="{Binding HoldMarkup}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static l:Strings.Holds_MarkHolds}" Command="{Binding StartCommand}" IsVisible="{Binding !IsActive}"
                            ToolTip.Tip="{x:Static l:Strings.Holds_MarkHoldsTip}"/>
                    <!-- D058 §6: the markup is finished on the Preview's bar («Готово» there); here only its state -->
                    <TextBlock x:Name="MarkupActiveText" Text="{x:Static l:Strings.Holds_MarkingInPreview}" IsVisible="{Binding IsActive}"
                               Foreground="{DynamicResource AccentTextBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="220"/>
                    <TextBlock Text="{Binding HoldCount, StringFormat={x:Static l:Strings.Holds_MarkedCount}}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- D056 §3: outside every green near the FIT's routes — the route the holds are marked on. -->
                  <StackPanel Spacing="4" IsVisible="{Binding ShowsRouteChoice}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Static l:Strings.Holds_Route}" Classes="label" VerticalAlignment="Center"/>
                      <ComboBox ItemsSource="{Binding RouteChoices}" SelectedIndex="{Binding SelectedRouteChoiceIndex, Mode=TwoWay}" MinWidth="200"
                                IsEnabled="{Binding !IsActive}" ToolTip.Tip="{x:Static l:Strings.Holds_RouteTip}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RouteChoiceHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding RouteChoiceHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- D072 §3: the route proposed from its first hold — the review: «Принять», «Отменить» (amendment 2: no tolerance). -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsRouteReview}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static l:Strings.Holds_RouteAccept}" Command="{Binding AcceptRouteCommand}"/>
                      <Button Content="{x:Static l:Strings.Holds_RouteCancel}" Command="{Binding CancelRouteCommand}"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- D072 §3: «Предлагать трассу» — the first click on a hold proposes the route. -->
                  <CheckBox Content="{x:Static l:Strings.Holds_ProposeAutomatically}" IsChecked="{Binding IsRouteProposalEnabled, Mode=TwoWay}"
                            IsVisible="{Binding CanShowProposalToggle}" ToolTip.Tip="{x:Static l:Strings.Holds_ProposeAutomaticallyTip}"/>

                  <!-- D072 amendment 1: no list — the proposals are reviewed on the Preview (a click selects, Delete removes); here their
                       count and «Отклонить все». -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRouteReview}">
                    <TextBlock Text="{Binding ProposalCount, StringFormat={x:Static l:Strings.Holds_RouteProposalCount}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{x:Static l:Strings.Holds_RejectAll}" Command="{Binding RejectAllProposalsCommand}"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Holds_Width}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="StrokeWidthSlider" Classes="inline" Focusable="False"
                          Minimum="{Binding MinStrokeWidth, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxStrokeWidth, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding StrokeWidth, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_Width}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding StrokeWidth, Mode=TwoWay}" Increment="1" Minimum="{Binding MinStrokeWidth}" Maximum="{Binding MaxStrokeWidth}"
                                   FormatString="0.####"/>
                      <TextBlock Text="{x:Static l:Strings.Holds_WidthUnit}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               ToolTip.Tip="{x:Static l:Strings.Holds_WidthUnitTip}"/>
                    </StackPanel>
                  </Grid>
                  <!-- D065 §3: the smoothing of a new hold's contour, a global setting. -->
                  <Grid ColumnDefinitions="Auto,Auto,Auto" ToolTip.Tip="{x:Static l:Strings.Holds_SmoothingTip}">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Holds_Smoothing}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ContourSmoothingSlider" Classes="inline" Focusable="False" TickFrequency="5" IsSnapToTickEnabled="True"
                          Minimum="{Binding MinContourSmoothing, Converter={x:Static common:DecimalDouble.Instance}}"
                          Maximum="{Binding MaxContourSmoothing, Converter={x:Static common:DecimalDouble.Instance}}"
                          Value="{Binding ContourSmoothing, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_SmoothingTip}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ContourSmoothing, Mode=TwoWay}" Increment="5" Minimum="{Binding MinContourSmoothing}" Maximum="{Binding MaxContourSmoothing}"
                                   FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_Colour}" Classes="label"/>
                    <!-- D062 amendment 1: one list — «Авто», then the palette's colours. -->
                    <ComboBox x:Name="HoldColorBox" ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding SelectedColorChoice, Mode=TwoWay}"
                              Width="130" PlaceholderText="{x:Static l:Strings.Holds_ModeManual}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="14" Height="14" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Background="{Binding Swatch}"
                                    IsVisible="{Binding !IsAuto}"/>
                            <TextBlock Text="{Binding Name}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Width="22" Height="22" CornerRadius="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Background="{Binding ColorHex}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ColorHex, Mode=TwoWay}" Width="80" MaxLength="7" IsVisible="{Binding IsManualColor}"
                             ToolTip.Tip="{x:Static l:Strings.Holds_ModeManual}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_Keyline}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding KeylineModes}" SelectedIndex="{Binding KeylineIndex, Mode=TwoWay}" Width="110"/>
                    <TextBlock Text="{x:Static l:Strings.Holds_KeylineOn}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding KeylineActive}"
                               ToolTip.Tip="{x:Static l:Strings.Holds_KeylineTip}"/>
                  </StackPanel>

                  <!-- D048 §3.4: the standard layout from the playhead (T) — an explicit action, one undo step. -->
                  <Button Content="{x:Static l:Strings.Holds_LayOut}" Command="{Binding LayOutIntroAndFinalCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_LayOutTip}"/>

                  <!-- Animation (Phase 21, D036): the holds appear one by one from a moment of the video, stay, and vanish
                       together. Every change is one undo step (consecutive changes of one setting merge). -->
                  <CheckBox Content="{x:Static l:Strings.Holds_Animate}" IsChecked="{Binding IsAnimated, Mode=TwoWay}"
                            ToolTip.Tip="{x:Static l:Strings.Holds_AnimateTip}"/>
                  <StackPanel Spacing="6" IsVisible="{Binding IsAnimated}">
                    <!-- D048 §3.1 / §3.3: a Duration-mode animation (made by the layout) has its length and three orders;
                         the Interval-mode fields below are hidden for it. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsIntervalMode}">
                      <TextBlock Text="{x:Static l:Strings.Holds_Order}" Classes="label"/>
                      <ComboBox ItemsSource="{Binding AnimationOrders}" SelectedIndex="{Binding AnimationOrderIndex, Mode=TwoWay}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDurationMode}">
                      <TextBlock Text="{x:Static l:Strings.Holds_Order}" Classes="label"/>
                      <ComboBox ItemsSource="{Binding DurationAnimationOrders}" SelectedIndex="{Binding DurationOrderIndex, Mode=TwoWay}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Static l:Strings.Holds_Start}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding AnimationStart, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="{Binding MaxAnimationStart}"
                                     FormatString="0.###"
                                     ToolTip.Tip="{x:Static l:Strings.Holds_StartTip}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="" Width="120"/>
                      <Button Content="{x:Static l:Strings.Holds_SetToPlayhead}" Command="{Binding SetStartToPlayheadCommand}"
                              ToolTip.Tip="{x:Static l:Strings.Holds_SetToPlayheadTip}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDurationMode}">
                      <TextBlock Text="{x:Static l:Strings.Holds_AnimationDuration}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding AnimationDuration, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="{Binding MaxAnimationDuration}"
                                     FormatString="0.###"
                                     ToolTip.Tip="{x:Static l:Strings.Holds_AnimationDurationTip}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsIntervalMode}">
                      <TextBlock Text="{x:Static l:Strings.Holds_Interval}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding AnimationInterval, Mode=TwoWay}" Increment="0.05" Minimum="{Binding MinAnimationInterval}" Maximum="{Binding MaxAnimationInterval}"
                                     FormatString="0.###"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Static l:Strings.Holds_AppearFade}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding AppearFade, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="{Binding MaxAnimationFade}"
                                     FormatString="0.###" ToolTip.Tip="{x:Static l:Strings.Holds_FadeTip}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsIntervalMode}">
                      <TextBlock Text="{x:Static l:Strings.Holds_StayAfterLast}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding StayAfterLast, Mode=TwoWay}" Increment="0.5" Minimum="0" Maximum="{Binding MaxAnimationStay}"
                                     FormatString="0.###" IsEnabled="{Binding !StayUntilClipEnd}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsIntervalMode}">
                      <TextBlock Text="" Width="120"/>
                      <CheckBox Content="{x:Static l:Strings.Holds_UntilClipEnd}" IsChecked="{Binding StayUntilClipEnd, Mode=TwoWay}"
                                ToolTip.Tip="{x:Static l:Strings.Holds_UntilClipEndTip}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsDisappearFade}">
                      <TextBlock Text="{x:Static l:Strings.Holds_DisappearFade}" Classes="label"/>
                      <controls:CommitNumericUpDown Classes="wide" Value="{Binding DisappearFade, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="{Binding MaxAnimationFade}"
                                     FormatString="0.###" ToolTip.Tip="{x:Static l:Strings.Holds_FadeTip}"/>
                      <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AnimationSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AnimationWarning}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding AnimationWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </StackPanel>

                  <!-- Hold tracking (R2 → E): the contours follow the wall while the camera moves; the state of the analysis (a
                       problem in the warning colour, K2) and the manual correction: "Follow the camera" is the clip's choice, saved
                       with the project (K3, one Undo step); "Retry" analyses a failed clip again. -->
                  <StackPanel Spacing="4" IsVisible="{Binding ShowsTracking}">
                    <CheckBox Content="{x:Static l:Strings.Holds_FollowCamera}" IsChecked="{Binding FollowsCamera, Mode=TwoWay}"
                              ToolTip.Tip="{x:Static l:Strings.Holds_FollowCameraTip}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding TrackingStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="230" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasTrackingProblem}"/>
                      <TextBlock Text="{Binding TrackingStatus}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" MaxWidth="230" VerticalAlignment="Center"
                                 IsVisible="{Binding HasTrackingProblem}"/>
                      <Button Content="{x:Static l:Strings.Holds_TrackingRetry}" Command="{Binding RetryTrackingCommand}"
                              IsVisible="{Binding IsTrackingFailed}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <StackPanel Spacing="16" IsVisible="{Binding !IsHoldsOnly}">

            <!-- COROS training (Phase 35, D050 amendment B2 / B4 and its amendment of 2026-11-02): this video's recording
                 start Z, set by matching the playhead's frame to the end (default) or the start of a climb (one Undo step;
                 choosing the point changes nothing), and the read-only mapping at the playhead. The training's clock
                 correction is a setting of the toolbar's COROS menu, never here. -->
            <Panel Classes="category" Tag="Fit">
            <controls:InspectorSection SectionId="training" Title="{x:Static l:Strings.Inspector_TrainingHeader}" IsVisible="{Binding ShowsTraining}">
              <StackPanel Spacing="6">
                <!-- D068 item 14: no training yet — the import is offered here, where the training is shown. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowsTrainingImport}" Margin="0,0,0,6">
                  <TextBlock Text="{x:Static l:Strings.Inspector_NoTraining}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  <Button x:Name="ImportTrainingButton" Content="{x:Static l:Strings.Inspector_ImportTraining}" Command="{Binding ImportTrainingCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Toolbar_TrainingTip}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <TextBlock Text="{Binding RecordingStartText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <!-- D055 §2: Z refines the route bounds only; the heart rate follows the file's time. -->
                <TextBlock Text="{x:Static l:Strings.Inspector_RecordingStartRoutesOnly}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                <!-- D054 §1: the climbs of this clip found by its video's time, no choice of a climb. -->
                <Button Content="{x:Static l:Strings.Inspector_RecognizeFitClimbs}" Command="{Binding RecognizeFitClimbsCommand}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_RecognizeFitClimbsTip}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{x:Static l:Strings.Inspector_RefineRecordingStart}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding TrainingClimbs}" SelectedIndex="{Binding SelectedClimbIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" ToolTip.Tip="{Binding AlignToClimbTip}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_AlignAnchor}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding AlignAnchors}" SelectedIndex="{Binding AlignAnchorIndex, Mode=TwoWay}"
                            ToolTip.Tip="{Binding AlignToClimbTip}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{Binding AlignToClimbText}" Command="{Binding AlignToClimbCommand}"
                          ToolTip.Tip="{Binding AlignToClimbTip}"/>
                  <Button Content="{x:Static l:Strings.Inspector_ClearRecordingStart}" Command="{Binding ClearRecordingStartCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding TrainingReadout}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- Phase 37 (D051 §8.2): the FIT marks of this clip's video and the link of its Duration animation; every
                 action one Undo step of the edit service. -->
            <Panel Classes="category" Tag="Fit">
            <controls:InspectorSection SectionId="fit" CollapsedByDefault="True" Title="{x:Static l:Strings.Inspector_FitServiceHeader}">
              <controls:InspectorSection.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="ShowsFitMarks"/>
                  <Binding Path="ShowsFitLink"/>
                </MultiBinding>
              </controls:InspectorSection.IsVisible>
              <StackPanel Spacing="12">
                <StackPanel Spacing="6" IsVisible="{Binding ShowsFitMarks}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_FitHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding FitMarkItems}" SelectedIndex="{Binding SelectedFitMarkIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                  <Button Content="{x:Static l:Strings.Inspector_FitLayOut}" Command="{Binding LayOutFromFitMarkCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Inspector_FitLayOutTip}" HorizontalAlignment="Stretch"/>
                  <WrapPanel>
                    <Button Content="{x:Static l:Strings.Inspector_FitMoveToPlayhead}" Command="{Binding MoveFitMarkToPlayheadCommand}" Margin="0,0,6,6"/>
                    <Button Content="{x:Static l:Strings.Inspector_FitDecline}" Command="{Binding DeclineFitMarkCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding ShowsFitLink}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_FitLinkHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding FitLinkText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding LinkableClimbs}" SelectedIndex="{Binding SelectedLinkableIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                  <WrapPanel>
                    <Button Content="{x:Static l:Strings.Inspector_FitLink}" Command="{Binding LinkFitClimbCommand}" Margin="0,0,6,6"/>
                    <Button Content="{x:Static l:Strings.Inspector_FitUnlink}" Command="{Binding UnlinkFitClimbCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- D069 §7: «Цвет» — a video clip's colour correction (Preview = export); «Автоулучшение» sets the sliders from the
                 clip's frames; each change one Undo step. -->
            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection x:Name="ColorSection" SectionId="color" ResetCommand="{Binding ResetColorCommand}" Title="{x:Static l:Strings.Inspector_ColorHeading}"
                                       IsVisible="{Binding HasColor}">
              <StackPanel Spacing="6">
                <Button x:Name="AutoEnhanceButton" Content="{x:Static l:Strings.Color_Auto}" Command="{Binding AutoEnhanceCommand}"
                        IsEnabled="{Binding !IsEnhancing}" ToolTip.Tip="{x:Static l:Strings.Color_AutoTip}" Margin="128,0,0,4"/>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Exposure}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorExposureSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorExposure, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Exposure}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorExposure, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Brightness}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorBrightnessSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorBrightness, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Brightness}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorBrightness, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Contrast}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorContrastSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorContrast, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Contrast}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorContrast, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Highlights}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorHighlightsSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorHighlights, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Highlights}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorHighlights, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Shadows}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorShadowsSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorShadows, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Shadows}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorShadows, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Saturation}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorSaturationSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorSaturation, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Saturation}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorSaturation, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Temperature}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorTemperatureSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorTemperature, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Temperature}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorTemperature, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Color_Tint}" Classes="label"/>
                    <Slider Grid.Column="1" x:Name="ColorTintSlider" Classes="inline" TickFrequency="1" Focusable="False" Minimum="-100" Maximum="100"
                            Value="{Binding ColorTint, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}" ToolTip.Tip="{x:Static l:Strings.Color_Tint}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <controls:CommitNumericUpDown Value="{Binding ColorTint, Mode=TwoWay}" Increment="1" Minimum="{Binding MinColor}"
                                     Maximum="{Binding MaxColor}" FormatString="0"/>
                    </StackPanel>
                  </Grid>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- Fades (Phase 10, D025): every clip kind, in whole frames of the project rate; the time is shown next to
                 each. On an edge with a dissolve the fade is kept but not applied (PO-8). -->

            <!-- Speed (Phase 7 Step 9, D022): video and audio clips; 0.25×–4× in steps of 0.05×. The start and
                 the source range stay, the duration follows. Consecutive changes merge into one undo step. -->
            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection SectionId="timing" Title="{x:Static l:Strings.Inspector_TimingHeading}" Summary="{Binding SpeedValue, StringFormat={}{0:0.##}×}">
              <controls:InspectorSection.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="ShowsFades"/>
                  <Binding Path="HasSpeed"/>
                </MultiBinding>
              </controls:InspectorSection.IsVisible>
              <StackPanel Spacing="10">
              <StackPanel Spacing="6" IsVisible="{Binding ShowsFades}">
                <TextBlock Text="{x:Static l:Strings.Inspector_FadesHeading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_FadeIn}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="FadeInSlider" Classes="inline" Focusable="False" Minimum="0"
                        Maximum="{Binding MaxFadeInFrames, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding FadeInFrames, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_FadeIn}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Value="{Binding FadeInFrames, Mode=TwoWay}" Increment="1" Minimum="0"
                                 Maximum="{Binding MaxFadeInFrames}" FormatString="0"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding FadeInTimeDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,-4,0,0"/>
                <TextBlock IsVisible="{Binding IsFadeInInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_FadeOut}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="FadeOutSlider" Classes="inline" Focusable="False" Minimum="0"
                        Maximum="{Binding MaxFadeOutFrames, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding FadeOutFrames, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_FadeOut}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Value="{Binding FadeOutFrames, Mode=TwoWay}" Increment="1" Minimum="0"
                                 Maximum="{Binding MaxFadeOutFrames}" FormatString="0"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding FadeOutTimeDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,-4,0,0"/>
                <TextBlock IsVisible="{Binding IsFadeOutInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="128,0,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasSpeed}">
                <TextBlock Text="{x:Static l:Strings.Inspector_SpeedHeading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Speed}" Classes="label"/>
                  <controls:CommitNumericUpDown Classes="wide" Value="{Binding SpeedValue, Mode=TwoWay}" Increment="{Binding SpeedIncrement}"
                                 Minimum="{Binding MinSpeed}" Maximum="{Binding MaxSpeed}" FormatString="0.00"/>
                  <TextBlock Text="×" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <!-- Audio (Phase 7): volume and mute are independent; every change is one edit. -->
            <Panel Classes="category" Tag="Audio">
            <controls:InspectorSection SectionId="audio" ResetCommand="{Binding ResetAudioCommand}" Title="{x:Static l:Strings.Inspector_AudioHeading}" Summary="{Binding VolumePercent, StringFormat={}{0:0.##} %}" IsVisible="{Binding HasAudioProperties}">
              <StackPanel Spacing="6">

                <Grid ColumnDefinitions="Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_Volume}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="VolumeSlider" Classes="inline" TickFrequency="5" Focusable="False" Minimum="0" Maximum="200"
                        Value="{Binding VolumePercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_Volume}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Value="{Binding VolumePercent, Mode=TwoWay}" Increment="1"
                                 Minimum="0" Maximum="200" FormatString="0.####"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <!-- Not focusable: Space stays Play/Pause instead of toggling the box after a click. -->
                <CheckBox Content="{x:Static l:Strings.Inspector_Mute}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Focusable="False"
                          Margin="128,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- D064 §2: the volume points (edited on the timeline's line). -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding VolumePointsText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center"/>
                  <Button FontSize="{DynamicResource FontSizeCaption}" Content="{x:Static l:Strings.Inspector_ClearVolumePoints}" Command="{Binding ClearVolumePointsCommand}"
                          IsVisible="{Binding HasVolumePoints}"/>
                </StackPanel>

                <!-- D064 §1: a video clip's sound-only fades (whole frames; the timeline's handles set them too). -->
                <StackPanel Spacing="6" IsVisible="{Binding HasSoundFades}" ToolTip.Tip="{x:Static l:Strings.Inspector_SoundFadeTip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_SoundFadeIn}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding SoundFadeInFrames, Mode=TwoWay}" Increment="1" Minimum="0" FormatString="0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_SoundFadeOut}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding SoundFadeOutFrames, Mode=TwoWay}" Increment="1" Minimum="0" FormatString="0"/>
                  </StackPanel>
                </StackPanel>

                <!-- D064 §5: the clean-up — two tools, each a strength (0 = off); non-destructive, processed in the background. -->
                <TextBlock Text="{x:Static l:Strings.Inspector_CleanupHeading}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Margin="0,6,0,0"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ToolTip.Tip="{x:Static l:Strings.Inspector_NoiseReductionTip}">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_NoiseReduction}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="NoiseReductionSlider" Classes="inline" TickFrequency="5" Focusable="False" Minimum="0" Maximum="100"
                        Value="{Binding NoiseReduction, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_NoiseReductionTip}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Value="{Binding NoiseReduction, Mode=TwoWay}" Increment="5" Minimum="0" Maximum="100" FormatString="0"/>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ToolTip.Tip="{x:Static l:Strings.Inspector_VoiceEnhancementTip}">
                  <TextBlock Grid.Column="0" Text="{x:Static l:Strings.Inspector_VoiceEnhancement}" Classes="label"/>
                  <Slider Grid.Column="1" x:Name="VoiceEnhancementSlider" Classes="inline" TickFrequency="5" Focusable="False" Minimum="0" Maximum="100"
                        Value="{Binding VoiceEnhancement, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_VoiceEnhancementTip}"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <controls:CommitNumericUpDown Value="{Binding VoiceEnhancement, Mode=TwoWay}" Increment="5" Minimum="0" Maximum="100" FormatString="0"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding CleanupStatus}" IsVisible="{Binding HasCleanupStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                  <Button FontSize="{DynamicResource FontSizeCaption}" Content="{x:Static l:Strings.Inspector_CleanupStop}" Command="{Binding CancelCleanupCommand}" IsVisible="{Binding CanCancelCleanup}"/>
                  <Button FontSize="{DynamicResource FontSizeCaption}" Content="{x:Static l:Strings.Inspector_CleanupRetry}" Command="{Binding RetryCleanupCommand}" IsVisible="{Binding CanRetryCleanup}"/>
                </StackPanel>
                <CheckBox Content="{x:Static l:Strings.Mixer_OriginalSound}" IsChecked="{Binding OriginalSound, Mode=TwoWay}" Focusable="False"
                          ToolTip.Tip="{x:Static l:Strings.Mixer_OriginalSoundTip}" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>

            <Panel Classes="category" Tag="Clip">
            <controls:InspectorSection SectionId="clip" Title="{x:Static l:Strings.Inspector_ClipHeading}">
              <StackPanel Spacing="6">

                <StackPanel Spacing="6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Source}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                    <TextBlock Text="{Binding ClipName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Type}" Classes="label"/>
                    <TextBlock Text="{Binding ClipTypeLabel}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_StartTime}" Classes="label"/>
                    <TextBlock Text="{Binding StartTimeDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_EndTime}" Classes="label"/>
                    <TextBlock Text="{Binding EndTimeDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                    <TextBlock Text="{Binding DurationDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Text="{Binding ClipFrameRateDisplay, StringFormat={x:Static l:Strings.Inspector_Timecode}}"
                             Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </controls:InspectorSection>
            </Panel>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
