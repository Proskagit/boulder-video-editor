<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:AiVideoEditor.UI.Common"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             x:Class="AiVideoEditor.UI.Views.Panels.InspectorView">

  <UserControl.Styles>
    <!-- Every numeric field: sign, digits and the decimal separator only (NumericInput). -->
    <Style Selector="NumericUpDown">
      <Setter Property="ParsingNumberStyle" Value="{x:Static common:NumericInput.ParsingStyle}"/>
    </Style>
    <!-- FU-25.1: in a 104 px field Fluent's two spinner buttons (≈ 35 px each) left the text ≈ 19 px — «100» showed as «10(».
         Narrower buttons (22 px) and a smaller text padding give the text ≈ 49 px at the same field width and height; the
         buttons, the arrow keys and typing work as before. Fluent sizes these parts in theme styles with an activator, which
         win over a plain selector, so these selectors carry one too (`:not(.theme-size)` — no element has that class). -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:not(.theme-size)">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox:not(.theme-size)">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="6,5,4,6"/>
    </Style>
    <!-- D039 §6: one label column for every field — wide enough for the Russian labels, a long one wraps instead of being cut. -->
    <Style Selector="TextBlock.label">
      <Setter Property="Width" Value="116"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- D039 §8 / D040 §4: a slider under a bounded field (Opacity, Volume, Fade In / Out, the hold line width); the field keeps
         exact typing, a drag is one undo step (D017). FU-25.2: Opacity, Volume and the line width take whole values (their
         view models round a typed fraction, step 1); their «0.####» shows a whole value as whole and a fraction saved
         before as it is. -->
    <!-- Phase 27 (D043 §3): a colour swatch and a cell of the placement grid. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>
    <Style Selector="Button.swatch > Border">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="BorderBrush" Value="#5A5A5A"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.cell">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style Selector="Slider.under">
      <Setter Property="Width" Value="118"/>
      <Setter Property="Margin" Value="124,-10,0,-6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#252526" BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <TextBlock Text="{x:Static l:Strings.Inspector_Heading}" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A"/>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="10" Spacing="16">

          <!-- Nothing selected -->
          <TextBlock IsVisible="{Binding IsNothingSelected}"
                     Text="{x:Static l:Strings.Inspector_NothingSelected}"
                     Foreground="#6A6A6A" FontSize="11" TextWrapping="Wrap"/>

          <!-- Media Browser selection (Phase 2) -->
          <StackPanel IsVisible="{Binding IsMediaSelected}" Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="{x:Static l:Strings.Inspector_MediaHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Spacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_FileName}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFileName}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Type}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaTypeLabel}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Format}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFormatLabel}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_FileSize}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFileSizeDisplay}" Foreground="#DDDDDD"/>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Path}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding MediaFilePath}" Foreground="#DDDDDD" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#3A3A3A"/>

            <StackPanel Spacing="6">
              <TextBlock Text="{x:Static l:Strings.Inspector_TechHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <TextBlock IsVisible="{Binding HasAnalysisStatusText}"
                         Text="{Binding AnalysisStatusText}" Foreground="#8A8A8A" FontSize="11"/>

              <TextBlock IsVisible="{Binding HasAnalysisError}"
                         Text="{Binding AnalysisErrorMessage}"
                         Foreground="#D98A8A" FontSize="11" TextWrapping="Wrap"/>

              <ItemsControl IsVisible="{Binding HasTechnicalInfo}" ItemsSource="{Binding TechnicalRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Label}" Foreground="#7A7A7A" FontSize="10"/>
                      <TextBlock Text="{Binding Value}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- Dissolve selection (Phase 10, D025): its length in whole frames (2 … the longest that fits, from the edit
               service), the time next to it, Remove. Disabled while an export runs. -->
          <StackPanel IsVisible="{Binding IsTransitionSelected}" IsEnabled="{Binding IsEditingAllowed}" Spacing="6">
            <TextBlock Text="{Binding TransitionHeader}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
            <TextBlock Text="{Binding DissolveClipsDisplay}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
            <!-- The audio crossfade (D032 R9): its length in whole frames, as before. -->
            <StackPanel IsVisible="{Binding IsAudioTransitionSelected}" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding DissolveFrames, Mode=TwoWay}" Increment="1" Minimum="{Binding MinDissolveFrames}"
                               Maximum="{Binding MaxDissolveFrames}" FormatString="0" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding DissolveTimeDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,-4,0,0"/>
              <TextBlock Text="{Binding DissolveLimitDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Phase 28 (D044 §5–§6): a video transition — the type (one that cannot fit is disabled with the reason), a
                 push's direction, the duration in seconds stored as whole frames (the stored seconds and frames under it). -->
            <StackPanel x:Name="TransitionLibrarySection" IsVisible="{Binding IsVideoTransitionSelected}" Spacing="6">
              <!-- The buttons wrap in the width left after the label column (a horizontal StackPanel gave them their own
                   width and pushed the section past the panel's edge at 300 px — the Phase 28 manual run, D1). -->
              <Grid ColumnDefinitions="124,*">
                <TextBlock Text="{x:Static l:Strings.Transition_Type}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <ItemsControl x:Name="TransitionTypeButtons" Grid.Column="1" ItemsSource="{Binding TransitionTypes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsAvailable}"
                                    ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" CommandParameter="{Binding TypeId}" FontSize="11" Margin="0,0,4,4"
                                    Command="{Binding $parent[UserControl].DataContext.SetTransitionTypeCommand}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <Grid ColumnDefinitions="124,*" IsVisible="{Binding IsPushSelected}">
                <TextBlock Text="{x:Static l:Strings.Transition_Direction}" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <ItemsControl x:Name="TransitionDirectionButtons" Grid.Column="1" ItemsSource="{Binding TransitionDirections}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding Direction}"
                                    FontSize="11" Margin="0,0,4,4" Command="{Binding $parent[UserControl].DataContext.SetTransitionDirectionCommand}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                <controls:CommitNumericUpDown x:Name="TransitionSecondsField" Value="{Binding TransitionSeconds, Mode=TwoWay}" Increment="0.1"
                               StepCommand="{Binding StepTransitionSecondsCommand}"
                               Minimum="{Binding MinTransitionSeconds}" Maximum="{Binding MaxTransitionSeconds}" FormatString="0.##" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="TransitionSlider" Classes="under" Focusable="False" TickFrequency="0.1"
                      Minimum="{Binding MinTransitionSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Maximum="{Binding MaxTransitionSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding TransitionSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_Duration}"/>
              <TextBlock Text="{Binding TransitionDurationDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,-4,0,0"/>
              <TextBlock Text="{Binding TransitionLimitDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- A long label («Удалить перекрёстное затухание») wraps instead of passing the panel's edge (D1). -->
            <Button x:Name="RemoveTransitionButton" Command="{Binding RemoveDissolveCommand}" Margin="124,4,0,0" FontSize="11">
              <TextBlock Text="{Binding RemoveTransitionLabel}" TextWrapping="Wrap"/>
            </Button>
          </StackPanel>

          <!-- Timeline clip selection (Phase 4) -->
          <StackPanel IsVisible="{Binding IsTimelineClipSelected}" IsEnabled="{Binding IsEditingAllowed}" Spacing="16">
            <!-- Text (Phase 7 Step 8): text clips only. Every field applies live; consecutive changes of one
                 field merge into one undo step. The color applies once it is a complete #RRGGBB. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasTextProperties}">
              <TextBlock Text="{x:Static l:Strings.Inspector_TextHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <TextBox Text="{Binding TextContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="60" MaxHeight="160"/>
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Font}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamilyName, Mode=TwoWay}" Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Size}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding FontSize, Mode=TwoWay}" Increment="1" Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}"
                                 FormatString="0.##" Width="104"/>
                  <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="FontSizeSlider" Classes="under" Focusable="False"
                        Minimum="{Binding MinFontSize, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxFontSize, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding FontSize, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_Size}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Color}" Classes="label"/>
                  <TextBox Text="{Binding TextColorHex, Mode=TwoWay}" Width="110" MaxLength="7"/>
                  <Border Width="22" Height="22" CornerRadius="2" BorderBrush="#5A5A5A" BorderThickness="1"
                          Background="{Binding TextColorSwatch}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Phase 27 (D043 §3): a swatch is one click, one undo step; the field above stays for any colour. -->
                <ItemsControl x:Name="TextColorSwatches" ItemsSource="{Binding Swatches}" Margin="124,-2,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                              Command="{Binding $parent[UserControl].DataContext.SetTextColorCommand}">
                        <Border Background="{Binding Hex}"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{x:Static l:Strings.Inspector_Bold}" IsChecked="{Binding IsBold, Mode=TwoWay}" Margin="124,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Alignment}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment, Mode=TwoWay}" Width="150">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static l:AlignmentText.Instance}}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <!-- Phase 27 (D043 §2, Q3): the outline and the background, each switched and set on its own (values kept
                     while off); the switch and a swatch one undo step each, the thickness / opacity merge (D017). -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Outline}" Classes="label"/>
                  <CheckBox x:Name="OutlineToggle" IsChecked="{Binding IsOutlineOn, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"/>
                  <Border Width="22" Height="22" CornerRadius="2" BorderBrush="#5A5A5A" BorderThickness="1"
                          Background="{Binding OutlineColorSwatch}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="OutlineColorSwatches" ItemsSource="{Binding Swatches}" Margin="124,-2,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                              Command="{Binding $parent[UserControl].DataContext.SetOutlineColorCommand}">
                        <Border Background="{Binding Hex}"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_OutlineThickness}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding OutlineThicknessPercent, Mode=TwoWay}" Increment="1"
                                 Minimum="{Binding MinOutlineThicknessPercent}" Maximum="{Binding MaxOutlineThicknessPercent}"
                                 FormatString="0.####" Width="104" ToolTip.Tip="{x:Static l:Strings.Inspector_OutlineThicknessTip}"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="OutlineThicknessSlider" Classes="under" Focusable="False"
                        Minimum="{Binding MinOutlineThicknessPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxOutlineThicknessPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding OutlineThicknessPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_OutlineThicknessTip}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Background}" Classes="label"/>
                  <CheckBox x:Name="BackgroundToggle" IsChecked="{Binding IsBackgroundOn, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"/>
                  <Border Width="22" Height="22" CornerRadius="2" BorderBrush="#5A5A5A" BorderThickness="1"
                          Background="{Binding BackgroundColorSwatch}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="BackgroundColorSwatches" ItemsSource="{Binding Swatches}" Margin="124,-2,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="swatch" ToolTip.Tip="{Binding Name}" CommandParameter="{Binding Hex}"
                              Command="{Binding $parent[UserControl].DataContext.SetBackgroundColorCommand}">
                        <Border Background="{Binding Hex}"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_BackgroundOpacity}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding BackgroundOpacityPercent, Mode=TwoWay}" Increment="1"
                                 Minimum="{Binding MinBackgroundOpacityPercent}" Maximum="{Binding MaxBackgroundOpacityPercent}"
                                 FormatString="0.####" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="BackgroundOpacitySlider" Classes="under" Focusable="False"
                        Minimum="{Binding MinBackgroundOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxBackgroundOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding BackgroundOpacityPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_BackgroundOpacity}"/>
              </StackPanel>
            </StackPanel>

            <!-- Phase 27 (D043 §1, Q1–Q2): a text's appearance and disappearance — the kind and its duration, which is the
                 clip's fade (stored in whole frames, D025); a kind or a direction is one undo step, a duration merges. -->
            <StackPanel x:Name="TextAnimationSection" Spacing="6" IsVisible="{Binding HasTextProperties}">
              <TextBlock Text="{x:Static l:Strings.Inspector_AnimationHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Appear}" Classes="label"/>
                <ComboBox x:Name="AppearKind" ItemsSource="{Binding AppearanceKinds}" SelectedIndex="{Binding AppearKindIndex, Mode=TwoWay}" Width="150"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAppearSlide}">
                <TextBlock Text="{x:Static l:Strings.Inspector_MotionSide}" Classes="label"/>
                <ComboBox ItemsSource="{Binding MotionSides}" SelectedIndex="{Binding AppearSideIndex, Mode=TwoWay}" Width="150"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAppearTimed}">
                <TextBlock Text="{x:Static l:Strings.Inspector_MotionDuration}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding AppearSeconds, Mode=TwoWay}" Increment="0.1" Minimum="{Binding MinAppearSeconds}"
                               Maximum="{Binding MaxAppearSeconds}" FormatString="0.##" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="AppearSlider" Classes="under" Focusable="False" TickFrequency="0.1" IsVisible="{Binding IsAppearTimed}"
                      Minimum="{Binding MinAppearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Maximum="{Binding MaxAppearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding AppearSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_Appear}"/>
              <TextBlock IsVisible="{Binding IsFadeInInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                         Foreground="#C8A060" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Disappear}" Classes="label"/>
                <ComboBox x:Name="DisappearKind" ItemsSource="{Binding AppearanceKinds}" SelectedIndex="{Binding DisappearKindIndex, Mode=TwoWay}" Width="150"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDisappearSlide}">
                <TextBlock Text="{x:Static l:Strings.Inspector_MotionSide}" Classes="label"/>
                <ComboBox ItemsSource="{Binding MotionSides}" SelectedIndex="{Binding DisappearSideIndex, Mode=TwoWay}" Width="150"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDisappearTimed}">
                <TextBlock Text="{x:Static l:Strings.Inspector_MotionDuration}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding DisappearSeconds, Mode=TwoWay}" Increment="0.1" Minimum="{Binding MinDisappearSeconds}"
                               Maximum="{Binding MaxDisappearSeconds}" FormatString="0.##" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="DisappearSlider" Classes="under" Focusable="False" TickFrequency="0.1" IsVisible="{Binding IsDisappearTimed}"
                      Minimum="{Binding MinDisappearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Maximum="{Binding MaxDisappearSeconds, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding DisappearSeconds, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_Disappear}"/>
              <TextBlock IsVisible="{Binding IsFadeOutInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                         Foreground="#C8A060" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Transform and opacity (Phase 7): video, image and text clips. Every change is one edit;
                 consecutive changes of one field merge into one undo step. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasVisualProperties}">
              <TextBlock Text="{x:Static l:Strings.Inspector_TransformHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Spacing="6">
                <!-- Phase 27 (D043 §3, Q4): the 3 × 3 grid places a text's box at the safe margin, one undo step a cell; the X /
                     Y fields and the free move in the Preview stay. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTextProperties}">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Placement}" Classes="label"/>
                  <UniformGrid x:Name="PlacementGrid" Rows="3" Columns="3">
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Left" ToolTip.Tip="{x:Static l:Strings.Grid_TopLeft}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_TopCentre}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Top,Right" ToolTip.Tip="{x:Static l:Strings.Grid_TopRight}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Left" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleLeft}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleCentre}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Middle,Right" ToolTip.Tip="{x:Static l:Strings.Grid_MiddleRight}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Left" ToolTip.Tip="{x:Static l:Strings.Grid_BottomLeft}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Centre" ToolTip.Tip="{x:Static l:Strings.Grid_BottomCentre}"/>
                    <Button Classes="cell" Command="{Binding PlaceCommand}" CommandParameter="Bottom,Right" ToolTip.Tip="{x:Static l:Strings.Grid_BottomRight}"/>
                  </UniformGrid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_PositionX}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding PositionX, Mode=TwoWay}" Increment="1" Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}"
                                 FormatString="0.##" Width="104"/>
                  <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_PositionY}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding PositionY, Mode=TwoWay}" Increment="1" Minimum="{Binding MinPosition}" Maximum="{Binding MaxPosition}"
                                 FormatString="0.##" Width="104"/>
                  <TextBlock Text="{x:Static l:Strings.Unit_Px}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Scale}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding ScalePercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinScalePercent}" Maximum="{Binding MaxScalePercent}"
                                 FormatString="0.##" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Fill / Fit (Phase 26, D041 §2): a one-off Scale for a video or image clip. -->
                <WrapPanel x:Name="FramingButtons" Orientation="Horizontal" Margin="124,0,0,0" IsVisible="{Binding HasCrop}">
                  <Button Content="{x:Static l:Strings.Frame_Fill}" Command="{Binding FillFrameCommand}" IsEnabled="{Binding IsEditingAllowed}"
                          FontSize="11" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Frame_FillTip}"/>
                  <Button Content="{x:Static l:Strings.Frame_Fit}" Command="{Binding FitFrameCommand}" IsEnabled="{Binding IsEditingAllowed}"
                          FontSize="11" Margin="0,0,6,4" ToolTip.Tip="{x:Static l:Strings.Frame_FitTip}"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Rotation}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding Rotation, Mode=TwoWay}" Increment="1" Minimum="{Binding MinRotation}" Maximum="{Binding MaxRotation}"
                                 FormatString="0.##" Width="104"/>
                  <TextBlock Text="°" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Opacity}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding OpacityPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinOpacityPercent}" Maximum="{Binding MaxOpacityPercent}"
                                 FormatString="0.####" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="OpacitySlider" Classes="under" Focusable="False" Minimum="{Binding MinOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxOpacityPercent, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding OpacityPercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Inspector_Opacity}"/>
              </StackPanel>
            </StackPanel>

            <!-- Crop (Phase 7): pictures only, fractions of the source per edge. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasCrop}">
              <TextBlock Text="{x:Static l:Strings.Inspector_CropHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Left}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding CropLeftPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                 FormatString="0.#" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Top}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding CropTopPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                 FormatString="0.#" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Right}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding CropRightPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                 FormatString="0.#" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Bottom}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding CropBottomPercent, Mode=TwoWay}" Increment="1" Minimum="{Binding MinCropPercent}" Maximum="{Binding MaxCropPercent}"
                                 FormatString="0.#" Width="104"/>
                  <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Holds (Phase 19, D034): video clips only. The AI markup of the route on this clip and the outline's
                 style; every change is one undo step (consecutive changes of one field merge). -->
            <StackPanel Spacing="6" IsVisible="{Binding HoldMarkup.HasClip, FallbackValue=False}">
              <TextBlock Text="{x:Static l:Strings.Inspector_HoldsHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Spacing="6" DataContext="{Binding HoldMarkup}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static l:Strings.Holds_MarkHolds}" Command="{Binding StartCommand}" IsVisible="{Binding !IsActive}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_MarkHoldsTip}"/>
                  <Button Content="{x:Static l:Strings.Holds_Done}" Command="{Binding DoneCommand}" IsVisible="{Binding IsActive}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_DoneTip}"/>
                  <TextBlock Text="{Binding HoldCount, StringFormat={x:Static l:Strings.Holds_MarkedCount}}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Holds_Width}" Classes="label"/>
                  <controls:CommitNumericUpDown Value="{Binding StrokeWidth, Mode=TwoWay}" Increment="1" Minimum="{Binding MinStrokeWidth}" Maximum="{Binding MaxStrokeWidth}"
                                 FormatString="0.####" Width="104"/>
                  <TextBlock Text="{x:Static l:Strings.Holds_WidthUnit}" Foreground="#AAAAAA" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static l:Strings.Holds_WidthUnitTip}"/>
                </StackPanel>
                <Slider x:Name="StrokeWidthSlider" Classes="under" Focusable="False"
                        Minimum="{Binding MinStrokeWidth, Converter={x:Static common:DecimalDouble.Instance}}"
                        Maximum="{Binding MaxStrokeWidth, Converter={x:Static common:DecimalDouble.Instance}}"
                        Value="{Binding StrokeWidth, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                        ToolTip.Tip="{x:Static l:Strings.Holds_Width}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Holds_Colour}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding ColorModes}" SelectedIndex="{Binding ColorModeIndex, Mode=TwoWay}" Width="110"/>
                  <Border Width="22" Height="22" CornerRadius="2" BorderBrush="#5A5A5A" BorderThickness="1"
                          Background="{Binding ColorHex}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsManualColor}">
                  <TextBlock Text="" Width="116"/>
                  <ComboBox ItemsSource="{Binding Palette}" SelectedItem="{Binding PaletteSelection, Mode=TwoWay}" Width="110"
                            PlaceholderText="{x:Static l:Strings.Holds_Palette}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="14" Height="14" CornerRadius="2" BorderBrush="#5A5A5A" BorderThickness="1" Background="{Binding Hex}"/>
                          <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding ColorHex, Mode=TwoWay}" Width="80" MaxLength="7"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Holds_Keyline}" Classes="label"/>
                  <ComboBox ItemsSource="{Binding KeylineModes}" SelectedIndex="{Binding KeylineIndex, Mode=TwoWay}" Width="110"/>
                  <TextBlock Text="{x:Static l:Strings.Holds_KeylineOn}" Foreground="#AAAAAA" VerticalAlignment="Center" IsVisible="{Binding KeylineActive}"
                             ToolTip.Tip="{x:Static l:Strings.Holds_KeylineTip}"/>
                </StackPanel>

                <!-- Animation (Phase 21, D036): the holds appear one by one from a moment of the video, stay, and vanish
                     together. Every change is one undo step (consecutive changes of one setting merge). -->
                <CheckBox Content="{x:Static l:Strings.Holds_Animate}" IsChecked="{Binding IsAnimated, Mode=TwoWay}"
                          ToolTip.Tip="{x:Static l:Strings.Holds_AnimateTip}"/>
                <StackPanel Spacing="6" IsVisible="{Binding IsAnimated}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_Order}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding AnimationOrders}" SelectedIndex="{Binding AnimationOrderIndex, Mode=TwoWay}" Width="140"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_Start}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding AnimationStart, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="{Binding MaxAnimationStart}"
                                   FormatString="0.###" Width="104"
                                   ToolTip.Tip="{x:Static l:Strings.Holds_StartTip}"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="" Width="116"/>
                    <Button Content="{x:Static l:Strings.Holds_SetToPlayhead}" Command="{Binding SetStartToPlayheadCommand}"
                            ToolTip.Tip="{x:Static l:Strings.Holds_SetToPlayheadTip}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_Interval}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding AnimationInterval, Mode=TwoWay}" Increment="0.05" Minimum="{Binding MinAnimationInterval}" Maximum="{Binding MaxAnimationInterval}"
                                   FormatString="0.###" Width="104"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_AppearFade}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding AppearFade, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="{Binding MaxAnimationFade}"
                                   FormatString="0.###" Width="104" ToolTip.Tip="{x:Static l:Strings.Holds_FadeTip}"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static l:Strings.Holds_StayAfterLast}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding StayAfterLast, Mode=TwoWay}" Increment="0.5" Minimum="0" Maximum="{Binding MaxAnimationStay}"
                                   FormatString="0.###" Width="104" IsEnabled="{Binding !StayUntilClipEnd}"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="" Width="116"/>
                    <CheckBox Content="{x:Static l:Strings.Holds_UntilClipEnd}" IsChecked="{Binding StayUntilClipEnd, Mode=TwoWay}"
                              ToolTip.Tip="{x:Static l:Strings.Holds_UntilClipEndTip}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !StayUntilClipEnd}">
                    <TextBlock Text="{x:Static l:Strings.Holds_DisappearFade}" Classes="label"/>
                    <controls:CommitNumericUpDown Value="{Binding DisappearFade, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="{Binding MaxAnimationFade}"
                                   FormatString="0.###" Width="104" ToolTip.Tip="{x:Static l:Strings.Holds_FadeTip}"/>
                    <TextBlock Text="{x:Static l:Strings.Unit_Seconds}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding AnimationSummary}" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding AnimationWarning}" Foreground="#E0A040" TextWrapping="Wrap"
                             IsVisible="{Binding AnimationWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Fades (Phase 10, D025): every clip kind, in whole frames of the project rate; the time is shown next to
                 each. On an edge with a dissolve the fade is kept but not applied (PO-8). -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowsFades}">
              <TextBlock Text="{x:Static l:Strings.Inspector_FadesHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_FadeIn}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding FadeInFrames, Mode=TwoWay}" Increment="1" Minimum="0"
                               Maximum="{Binding MaxFadeInFrames}" FormatString="0" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="FadeInSlider" Classes="under" Focusable="False" Minimum="0"
                      Maximum="{Binding MaxFadeInFrames, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding FadeInFrames, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_FadeIn}"/>
              <TextBlock Text="{Binding FadeInTimeDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,-4,0,0"/>
              <TextBlock IsVisible="{Binding IsFadeInInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                         Foreground="#C8A060" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_FadeOut}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding FadeOutFrames, Mode=TwoWay}" Increment="1" Minimum="0"
                               Maximum="{Binding MaxFadeOutFrames}" FormatString="0" Width="104"/>
                <TextBlock Text="{x:Static l:Strings.Unit_Frames}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="FadeOutSlider" Classes="under" Focusable="False" Minimum="0"
                      Maximum="{Binding MaxFadeOutFrames, Converter={x:Static common:DecimalDouble.Instance}}"
                      Value="{Binding FadeOutFrames, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_FadeOut}"/>
              <TextBlock Text="{Binding FadeOutTimeDisplay}" Foreground="#7A7A7A" FontSize="10" Margin="124,-4,0,0"/>
              <TextBlock IsVisible="{Binding IsFadeOutInactive}" Text="{x:Static l:Strings.Inspector_FadeInactive}"
                         Foreground="#C8A060" FontSize="10" Margin="124,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Speed (Phase 7 Step 9, D022): video and audio clips; 0.25×–4× in steps of 0.05×. The start and
                 the source range stay, the duration follows. Consecutive changes merge into one undo step. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasSpeed}">
              <TextBlock Text="{x:Static l:Strings.Inspector_SpeedHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Speed}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding SpeedValue, Mode=TwoWay}" Increment="{Binding SpeedIncrement}"
                               Minimum="{Binding MinSpeed}" Maximum="{Binding MaxSpeed}" FormatString="0.00" Width="104"/>
                <TextBlock Text="×" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

            <!-- Audio (Phase 7): volume and mute are independent; every change is one edit. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasAudioProperties}">
              <TextBlock Text="{x:Static l:Strings.Inspector_AudioHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static l:Strings.Inspector_Volume}" Classes="label"/>
                <controls:CommitNumericUpDown Value="{Binding VolumePercent, Mode=TwoWay}" Increment="1"
                               Minimum="0" Maximum="200" FormatString="0.####" Width="104"/>
                <TextBlock Text="%" Foreground="#AAAAAA" VerticalAlignment="Center"/>
              </StackPanel>
              <Slider x:Name="VolumeSlider" Classes="under" Focusable="False" Minimum="0" Maximum="200"
                      Value="{Binding VolumePercent, Mode=TwoWay, Converter={x:Static common:DecimalDouble.Instance}}"
                      ToolTip.Tip="{x:Static l:Strings.Inspector_Volume}"/>

              <!-- Not focusable: Space stays Play/Pause instead of toggling the box after a click. -->
              <CheckBox Content="{x:Static l:Strings.Inspector_Mute}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Focusable="False"
                        Margin="124,0,0,0" Foreground="#DDDDDD"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="{x:Static l:Strings.Inspector_ClipHeading}" FontSize="10" FontWeight="Bold" Foreground="#7A7A7A"/>

              <StackPanel Spacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Source}" Foreground="#7A7A7A" FontSize="10"/>
                  <TextBlock Text="{Binding ClipName}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Type}" Classes="label"/>
                  <TextBlock Text="{Binding ClipTypeLabel}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_StartTime}" Classes="label"/>
                  <TextBlock Text="{Binding StartTimeDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_EndTime}" Classes="label"/>
                  <TextBlock Text="{Binding EndTimeDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Static l:Strings.Inspector_Duration}" Classes="label"/>
                  <TextBlock Text="{Binding DurationDisplay}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding ClipFrameRateDisplay, StringFormat={x:Static l:Strings.Inspector_Timecode}}"
                           Foreground="#6A6A6A" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
