<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:AiVideoEditor.UI.Rendering"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             xmlns:panels="using:AiVideoEditor.UI.Views.Panels"
             x:Class="AiVideoEditor.UI.Views.Panels.TimelineView"
             Focusable="True">

  <UserControl.Resources>
    <!-- D064: the mixer flyout of the tool bar. -->
    <Flyout x:Key="MixerFlyout" Placement="BottomEdgeAlignedLeft">
      <panels:MixerPanel DataContext="{Binding Mixer}"/>
    </Flyout>
    <!-- D044 §6: the menu of the library's five types under "Transition" (shown by the view when the view model asks). -->
    <MenuFlyout x:Key="TransitionMenu" Placement="BottomEdgeAlignedLeft">
      <MenuItem Header="{x:Static l:Strings.TransitionType_CrossDissolve}" Command="{Binding AddTransitionCommand}" CommandParameter="crossDissolve"/>
      <MenuItem Header="{x:Static l:Strings.TransitionType_DipToBlack}" Command="{Binding AddTransitionCommand}" CommandParameter="dipToBlack"/>
      <MenuItem Header="{x:Static l:Strings.TransitionType_Flash}" Command="{Binding AddTransitionCommand}" CommandParameter="flash"/>
      <MenuItem Header="{x:Static l:Strings.TransitionType_Zoom}" Command="{Binding AddTransitionCommand}" CommandParameter="zoom"/>
      <MenuItem Header="{x:Static l:Strings.TransitionType_Push}" Command="{Binding AddTransitionCommand}" CommandParameter="push"/>
    </MenuFlyout>
    <!-- D045 §5: the menu of the four templates of Phase 29 under «Шаблон», and the heart-rate overlay (Phase 35.5). -->
    <MenuFlyout x:Key="TemplateMenu" Placement="BottomEdgeAlignedLeft">
      <MenuItem Header="{x:Static l:Strings.TemplateType_Rec}" Command="{Binding AddTemplateCommand}" CommandParameter="Rec"/>
      <MenuItem Header="{x:Static l:Strings.TemplateType_Vhs}" Command="{Binding AddTemplateCommand}" CommandParameter="Vhs"/>
      <MenuItem Header="{x:Static l:Strings.TemplateType_Boulder}" Command="{Binding AddTemplateCommand}" CommandParameter="Boulder"/>
      <MenuItem Header="{x:Static l:Strings.TemplateType_Highlight}" Command="{Binding AddTemplateCommand}" CommandParameter="Highlight"/>
      <!-- D068 amendment 1: only with a training. -->
      <MenuItem Header="{x:Static l:Strings.TemplateType_HeartRate}" Command="{Binding AddTemplateCommand}" CommandParameter="HeartRate"
                IsVisible="{Binding HasTraining}"/>
    </MenuFlyout>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Items on a Canvas are positioned through their container (ContentPresenter). -->
    <!-- Variant B: the clip's label stays readable over the plate's segments. -->
    <Style Selector="TextBlock.clipLabel.onSegments">
      <Setter Property="Background" Value="#A0202020"/>
      <Setter Property="Padding" Value="3,0"/>
    </Style>
    <!-- Variant B: a segment inside the plate — translucent, a dark line at its start marks the boundary. -->
    <Style Selector="Border.templateSegment">
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="BorderBrush" Value="#C0000000"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>
    <!-- Variant B: the selected orange inside the plate (§3.9). -->
    <Style Selector="Border.templateSegment.selected">
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <!-- D048 §3.9: the selected orange segment of the overlay strip. -->
    <Style Selector="Border.stripSegment.selected">
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ItemsControl.canvasItems > ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
    </Style>
    <!-- D051 §8.1: a selected FIT mark's cap is outlined. -->
    <Style Selector="Border.fitCap.selected">
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Border.dropGhost">
      <Setter Property="Background" Value="#3381D4FA"/>
      <Setter Property="BorderBrush" Value="#B381D4FA"/>
    </Style>
    <Style Selector="Border.dropGhost.movesOthers">
      <Setter Property="Background" Value="#33FFB300"/>
      <Setter Property="BorderBrush" Value="#CCFFB300"/>
    </Style>
    <Style Selector="Border.clip">
      <Setter Property="BorderBrush" Value="#000000"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.clip.selected">
      <Setter Property="BorderBrush" Value="#FFD54F"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.clip.invalid">
      <Setter Property="BorderBrush" Value="#E05A3C"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Border.trimHandle">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>
    <Style Selector="Border.trimHandle:pointerover">
      <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>
    <Style Selector="Border.dissolve">
      <Setter Property="Background" Value="#55B0C4DE"/>
      <Setter Property="BorderBrush" Value="#B0C4DE"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.dissolve.selected">
      <Setter Property="BorderBrush" Value="#FFD54F"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.trackRow">
      <Setter Property="Background" Value="#202020"/>
    </Style>
    <!-- D030 §4: a locked lane is tinted, a hidden lane's clips are dimmed (they are not drawn in the Preview / export) -->
    <Style Selector="Border.trackRow.locked">
      <Setter Property="Background" Value="#28231A"/>
    </Style>
    <Style Selector="Border.trackRow.hidden ItemsControl.canvasItems">
      <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <!-- D030 §4: the track header's mute / hide / lock toggles; off is quiet, on is coloured (lock in amber) -->
    <Style Selector="Button.trackState">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Button.trackState.on">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.trackState.mute.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B03A3A"/>
    </Style>
    <Style Selector="Button.trackState.hide.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A66B0"/>
    </Style>
    <Style Selector="Button.trackState.solo.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C9A227"/>
    </Style>
    <Style Selector="Button.trackState.lock.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D0921E"/>
    </Style>
    <Style Selector="Rectangle.inOutShade">
      <Setter Property="Fill" Value="#1AF2C94C"/>
    </Style>
    <Style Selector="Rectangle.inOutShade.current">
      <Setter Property="Fill" Value="#2EF2C94C"/>
    </Style>
    <Style Selector="Border.trackRow.dropTarget">
      <Setter Property="Background" Value="#2A3A4A"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
    <DockPanel>

      <!-- Header: title, project frame rate, timeline tools -->
      <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{x:Static l:Strings.Timeline_Heading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FrameRateDisplay}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- The tools wrap onto a second row when the window is too narrow for one (1024 px since Phase 17's Unlink / Link). Each
               command an icon and its label (D039 §7, D040 §5); − / + stay glyphs. -->
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <WrapPanel.Styles>
              <Style Selector="WrapPanel > Button, WrapPanel > ToggleButton">
                <Setter Property="Margin" Value="2,1"/>
              </Style>
              <!-- D068 item 3: an icon button is square, its icon a little larger than inside a labelled one. -->
              <Style Selector="WrapPanel > Button.icon, WrapPanel > ToggleButton.icon">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
              </Style>
            </WrapPanel.Styles>
            <!-- D068 item 3: adding content and the panels keep their labels; the frequent edits are icons with the name and the key in
                 the tooltip (as in CapCut and Insta360 Studio); Close gap, Paste, Link / Unlink live in the clip's context menu. -->
            <Button Classes="icon" Command="{Binding AddVideoTrackCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_AddVideoTrackTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_AddVideoTrack}">
              <controls:IconPath Glyph="{x:Static controls:Icons.VideoTrack}"/>
            </Button>
            <Button Classes="icon" Command="{Binding AddAudioTrackCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_AddAudioTrackTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_AddAudioTrack}">
              <controls:IconPath Glyph="{x:Static controls:Icons.AudioTrack}"/>
            </Button>
            <Button Command="{Binding AddTextCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_AddTextTip}" FontSize="{DynamicResource FontSizeCaption}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:IconPath Glyph="{x:Static controls:Icons.Text}" Width="12" Height="12"/>
                <TextBlock Text="{x:Static l:Strings.Timeline_AddText}"/>
              </StackPanel>
            </Button>
            <!-- D045 §5: «Шаблон» — the menu of the templates; each is added at the playhead on the top video track. -->
            <Button x:Name="TemplateButton" Flyout="{StaticResource TemplateMenu}" ToolTip.Tip="{x:Static l:Strings.Timeline_TemplateTip}" FontSize="{DynamicResource FontSizeCaption}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:IconPath Glyph="{x:Static controls:Icons.Template}" Width="12" Height="12"/>
                <TextBlock Text="{x:Static l:Strings.Timeline_Template}"/>
              </StackPanel>
            </Button>
            <Rectangle Width="1" Fill="{DynamicResource ControlBorderBrush}" Margin="4,2"/>
            <!-- D063 §1: the keyframe of the selected clip at the playhead (its transform, or on a followed part its framing). -->
            <Button x:Name="KeyframeButton" Command="{Binding ToggleKeyframeCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_KeyframeTip}" FontSize="{DynamicResource FontSizeCaption}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:IconPath Glyph="{x:Static controls:Icons.Keyframe}" Width="12" Height="12"/>
                <TextBlock Text="{x:Static l:Strings.Timeline_Keyframe}"/>
              </StackPanel>
            </Button>
            <!-- D064: the mixer — the master, every track's volume, M and S, the comparison with the original sound. -->
            <Button Flyout="{StaticResource MixerFlyout}" ToolTip.Tip="{x:Static l:Strings.Timeline_MixerTip}" FontSize="{DynamicResource FontSizeCaption}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:IconPath Glyph="{x:Static controls:Icons.Mixer}" Width="12" Height="12"/>
                <TextBlock Text="{x:Static l:Strings.Timeline_Mixer}"/>
              </StackPanel>
            </Button>
            <Rectangle Width="1" Fill="{DynamicResource ControlBorderBrush}" Margin="4,2"/>
            <Button Classes="icon" Command="{Binding SplitAtPlayheadCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_SplitTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Split}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Split}"/>
            </Button>
            <Button Classes="icon" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_DeleteTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Delete}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Delete}"/>
            </Button>
            <Button Classes="icon" Command="{Binding RippleDeleteCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_RippleDeleteTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_RippleDelete}">
              <controls:IconPath Glyph="{x:Static controls:Icons.RippleDelete}"/>
            </Button>
            <Button Classes="icon" Command="{Binding DuplicateCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_DuplicateTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Duplicate}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Duplicate}"/>
            </Button>
            <!-- D044 §6: "Transition" — on a video track the menu of the library's five types, on an audio track the
                 crossfade at once (the view model raises TransitionMenuRequested for the menu). -->
            <Button x:Name="TransitionButton" Classes="icon" Command="{Binding OpenTransitionMenuCommand}" FlyoutBase.AttachedFlyout="{StaticResource TransitionMenu}" ToolTip.Tip="{x:Static l:Strings.Timeline_TransitionTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Transition}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Dissolve}"/>
            </Button>
            <ToggleButton Classes="icon" IsChecked="{Binding SnappingEnabled}" ToolTip.Tip="{x:Static l:Strings.Timeline_SnapTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Snap}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Snap}"/>
            </ToggleButton>
            <!-- D048 variant B is the default (segments inside the «Боулдер»); this Debug-only switch turns back to the lane. -->
            <ToggleButton Classes="icon" IsChecked="{Binding SegmentsInTemplate}" IsVisible="{Binding IsDebugBuild}"
                          ToolTip.Tip="{x:Static l:Strings.Timeline_SegmentsInTemplateTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_SegmentsInTemplate}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Eye}"/>
            </ToggleButton>
            <Rectangle Width="1" Fill="{DynamicResource ControlBorderBrush}" Margin="4,2"/>
            <Button Classes="icon" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_ZoomOutTip}"/>
            <Button Classes="icon" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_ZoomInTip}"/>
            <Button Classes="icon" Command="{Binding ZoomToFitCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_FitTip}" AutomationProperties.Name="{x:Static l:Strings.Timeline_Fit}">
              <controls:IconPath Glyph="{x:Static controls:Icons.Fit}"/>
            </Button>
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- D068 amendment 1: the track headers 112 px — their two rows of buttons were cut at 84. -->
      <Grid ColumnDefinitions="112,*">

        <!-- Track headers: scroll vertically in sync with the tracks (see code-behind). -->
        <ScrollViewer x:Name="HeaderScroll" Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Markers (D027 §6): in the corner left of the ruler, at its height -->
            <StackPanel Height="24" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
              <StackPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                  <Setter Property="Padding" Value="1,0"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Height" Value="18"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
              </StackPanel.Styles>
              <Button Content="◀" Command="{Binding PreviousMarkerCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_PrevMarkerTip}"/>
              <Button Content="◆+" Command="{Binding AddMarkerCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_AddMarkerTip}"/>
              <Button Content="◆−" Command="{Binding RemoveMarkerCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_RemoveMarkerTip}"/>
              <Button Content="▶" Command="{Binding NextMarkerCommand}" ToolTip.Tip="{x:Static l:Strings.Timeline_NextMarkerTip}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Tracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="44" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <!-- The name and the state toggles (D030 §4): video M / 👁 / 🔒, audio M / 🔒 (no hide: no picture) -->
                      <DockPanel Margin="4,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                          <Button Classes="trackState mute" Classes.on="{Binding IsMuted}" Content="M"
                                  ToolTip.Tip="{x:Static l:Strings.Track_MuteTip}"
                                  Command="{Binding $parent[ItemsControl].DataContext.ToggleTrackMuteCommand}" CommandParameter="{Binding}"/>
                          <!-- D064 §1: solo — only the solo tracks sound (the Preview and the export) -->
                          <Button Classes="trackState solo" Classes.on="{Binding Mix.IsSolo}" Content="S"
                                  ToolTip.Tip="{x:Static l:Strings.Track_SoloTip}"
                                  Command="{Binding $parent[ItemsControl].DataContext.ToggleTrackSoloCommand}" CommandParameter="{Binding}"/>
                          <Button Classes="trackState hide" Classes.on="{Binding IsHidden}" IsVisible="{Binding CanHide}"
                                  ToolTip.Tip="{x:Static l:Strings.Track_HideTip}"
                                  Command="{Binding $parent[ItemsControl].DataContext.ToggleTrackHiddenCommand}" CommandParameter="{Binding}">
                            <controls:IconPath Glyph="{x:Static controls:Icons.Eye}" Width="10" Height="10" StrokeThickness="1.3"/>
                          </Button>
                          <Button Classes="trackState lock" Classes.on="{Binding IsLocked}"
                                  ToolTip.Tip="{x:Static l:Strings.Track_LockTip}"
                                  Command="{Binding $parent[ItemsControl].DataContext.ToggleTrackLockCommand}" CommandParameter="{Binding}">
                            <controls:IconPath Glyph="{x:Static controls:Icons.Lock}" Width="10" Height="10" StrokeThickness="1.3"/>
                          </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <!-- D027 §3: move among the tracks of its kind, delete (the edit service decides; locks, last track) -->
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <StackPanel.Styles>
                          <Style Selector="Button">
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Height" Value="16"/>
                          </Style>
                        </StackPanel.Styles>
                        <Button Content="▲" ToolTip.Tip="{x:Static l:Strings.Track_MoveUpTip}"
                                Command="{Binding $parent[ItemsControl].DataContext.MoveTrackUpCommand}" CommandParameter="{Binding}"/>
                        <Button Content="▼" ToolTip.Tip="{x:Static l:Strings.Track_MoveDownTip}"
                                Command="{Binding $parent[ItemsControl].DataContext.MoveTrackDownCommand}" CommandParameter="{Binding}"/>
                        <Button Content="✕" ToolTip.Tip="{x:Static l:Strings.Track_DeleteTip}"
                                Command="{Binding $parent[ItemsControl].DataContext.DeleteTrackCommand}" CommandParameter="{Binding}"/>
                        <!-- D064 §2 / §4: the track's volume and ducking -->
                        <Button ToolTip.Tip="{x:Static l:Strings.Track_MixTip}" Classes.on="{Binding Mix.IsDucking}"
                                AutomationProperties.Name="{x:Static l:Strings.Track_MixTip}">
                          <controls:IconPath Glyph="{x:Static controls:Icons.Mixer}" Width="10" Height="10" StrokeThickness="1.3"/>
                          <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                              <panels:TrackMixPanel DataContext="{Binding Mix}"/>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- D057 §3.10: the scroll bars always shown at their full width, not only on hover. -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="ContentRoot" RowDefinitions="24,Auto" Width="{Binding ContentWidth}"
                HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Time ruler: click / drag to move the playhead -->
            <Panel x:Name="Ruler" Grid.Row="0" Background="{DynamicResource Surface1Brush}" Cursor="Hand">
              <ItemsControl Classes="canvasItems" ItemsSource="{Binding RulerTicks}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Panel>
                      <Rectangle Width="1" Height="6" Fill="#5A5A5A" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="3,4,0,0"/>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Markers (D027 §6): a flag at the top of the ruler and a line down it; clicks go to the ruler -->
              <ItemsControl Classes="canvasItems" ItemsSource="{Binding Markers}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Canvas>
                      <Rectangle Width="1" Height="24" Fill="{Binding Color}"/>
                      <Polygon Points="-5,0 6,0 0.5,8" Fill="{Binding Color}"/>
                      <!-- D058 §4: the label beside the flag, short and trimmed so the ruler stays readable -->
                      <Border Canvas.Left="7" Canvas.Top="10" Background="#E0232323" CornerRadius="2" Padding="2,0"
                              IsVisible="{Binding HasLabel}" MaxWidth="140">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="{DynamicResource FontSizeCaption}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- D058 §4: a marker's label edited in place (double click on its flag); Enter sets it, Esc keeps it -->
              <Canvas IsVisible="{Binding IsEditingMarkerLabel}">
                <TextBox x:Name="MarkerLabelBox" Canvas.Left="{Binding MarkerLabelLeft}" Canvas.Top="0" Width="180" Height="22"
                         MinHeight="0" Padding="4,1" FontSize="{DynamicResource FontSizeCaption}" Text="{Binding MarkerLabelText, Mode=TwoWay}"
                         MaxLength="{Binding MaxMarkerLabelLength}" Watermark="{x:Static l:Strings.Timeline_MarkerLabelWatermark}"/>
              </Canvas>
            </Panel>

            <!-- Track lanes with clips -->
            <ItemsControl x:Name="TrackRows" Grid.Row="1" ItemsSource="{Binding Tracks}"
                          DragDrop.AllowDrop="True" Background="{DynamicResource Surface1Brush}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackRow" Classes.dropTarget="{Binding IsDropTarget}"
                          Classes.locked="{Binding IsLocked}" Classes.hidden="{Binding IsHidden}"
                          Height="44" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Panel>
                    <ItemsControl Classes="canvasItems" ItemsSource="{Binding Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Panel>
                          <Border Classes="clip" Classes.selected="{Binding IsSelected}" Classes.invalid="{Binding IsInvalid}"
                                  Width="{Binding Width}" Height="36" Margin="0,4,0,0"
                                  CornerRadius="2" Background="{Binding ColorHex}" ClipToBounds="True">
                            <Grid ColumnDefinitions="6,*,6">
                              <!-- D068 item 10: the video's pictures along the clip, under the waveform and the name. -->
                              <rendering:FilmstripView Grid.ColumnSpan="3" Filmstrip="{Binding Filmstrip}" IsVisible="{Binding HasFilmstrip}"/>
                              <!-- Waveform of the clip's sound (D024 Step 9.5): the whole clip for audio, the lower half for video. -->
                              <rendering:WaveformView Grid.ColumnSpan="3" Waveform="{Binding Waveform}" IsVisible="{Binding HasWaveform}"/>
                              <!-- Debug prototype: the anchored clip's strip inside the «Боулдер» — green, orange over it, lilac; a dark
                                   line at each segment's start marks the boundaries; the template's own colour stays at its edges. -->
                              <ItemsControl Classes="canvasItems" Grid.ColumnSpan="3" ItemsSource="{Binding TemplateSegments}"
                                            IsVisible="{Binding HasTemplateSegments}" IsHitTestVisible="False" ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <Canvas/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Classes="templateSegment" Classes.selected="{Binding IsSelected}" Width="{Binding Width}" Height="36"
                                            Background="{Binding ColorHex}"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <!-- Fade ramps (D025 §2): the effective fade in / out, darkening toward the clip's edge. -->
                              <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="{Binding FadeInWidth}" IsVisible="{Binding HasFadeIn}"
                                      IsHitTestVisible="False">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#B0000000"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                              <Border Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="{Binding FadeOutWidth}" IsVisible="{Binding HasFadeOut}"
                                      IsHitTestVisible="False">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#B0000000"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                              <!-- D064 §2: the volume line (the clip's volume × its points), on the selected clip its points and the
                                   sound's fade handles; the timeline asks its shape what a press is on. -->
                              <rendering:VolumeEnvelopeView Grid.ColumnSpan="3" Shape="{Binding VolumeShape}" IsVisible="{Binding HasVolumeLine}"/>
                              <!-- D045 §17: «Боулдер»'s status moment, a line on the clip at the frame its status appears. -->
                              <Canvas Grid.ColumnSpan="3" IsVisible="{Binding HasStatusMark}" IsHitTestVisible="False" ClipToBounds="True">
                                <Border Name="StatusMark" Canvas.Left="{Binding StatusMarkLeft}" Width="2" Height="44"
                                        Background="{Binding StatusMarkColorHex}"/>
                              </Canvas>
                              <TextBlock Grid.Column="1" Classes="clipLabel" Classes.onSegments="{Binding HasTemplateSegments}" Text="{Binding Label}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="2,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                         TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                              <!-- D066: the clip's sound is cleaned up (D064 §5) -->
                              <Border Grid.ColumnSpan="3" IsVisible="{Binding HasCleanup}" IsHitTestVisible="False" Background="#B0263238"
                                      CornerRadius="2" Padding="3,0" Margin="0,2,4,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{x:Static l:Strings.Timeline_CleanupBadge}" Foreground="{DynamicResource AccentTextBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                              </Border>
                              <!-- D030 §7 (Q12): while the clip is slipped, its planned Source In / Out over the clip -->
                              <Border Grid.ColumnSpan="3" IsVisible="{Binding IsSlipping}" IsHitTestVisible="False"
                                      Background="#D0141414" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding SlipText}" Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              </Border>
                              <!-- D048 §4.2: while a strip handle is dragged, the planned interval (and a refusal) in a compact label
                                   at the clip's bottom — the segments, the name and the status mark stay visible. -->
                              <Border Grid.ColumnSpan="3" IsVisible="{Binding IsStripDragging}" IsHitTestVisible="False" Classes.invalid="{Binding IsStripInvalid}"
                                      Background="#D0141414" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2" Padding="0,1">
                                <TextBlock Text="{Binding StripText}" Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              </Border>
                              <Border Grid.Column="0" Classes="trimHandle" Tag="TrimStart"/>
                              <Border Grid.Column="2" Classes="trimHandle" Tag="TrimEnd"/>
                            </Grid>
                          </Border>
                          <!-- D061 amendment 1: the followed part of the clip, a cyan strip along its bottom; its edges drag. -->
                          <ItemsControl x:Name="FollowLane" Tag="FollowLane" Classes="canvasItems" ItemsSource="{Binding FollowSegments}"
                                        IsVisible="{Binding HasFollowStrip}" Height="5" Margin="0,35,0,0" VerticalAlignment="Top"
                                        HorizontalAlignment="Left" Width="{Binding Width}" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Tag="FollowStrip" Width="{Binding Width}" Height="5" Background="#26C6DA" CornerRadius="1"
                                        Cursor="SizeWestEast" ToolTip.Tip="{Binding Tip}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- D063 §2: the keyframe diamonds — the clip's own along its top, a followed part's on its cyan strip; a press selects
               one (the playhead goes to it), a drag moves it along the frames. -->
          <ItemsControl x:Name="KeyframeLane" Tag="KeyframeLane" Classes="canvasItems" ItemsSource="{Binding KeyframeMarkers}"
                        IsVisible="{Binding HasKeyframes}" Height="44" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Width="{Binding Width}" ClipToBounds="True" Background="{x:Null}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Canvas Width="0" Height="44">
                  <Border Tag="Keyframe" Canvas.Left="-5" Canvas.Top="{Binding Top}" Width="10" Height="10" Background="{Binding Fill}"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="SizeWestEast" ToolTip.Tip="{Binding Tip}"
                          RenderTransform="rotate(45deg)"/>
                </Canvas>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Variant B: the parts of the anchored clip's segments outside the plate (an orange before its start or after
                               its end), beside it, translucent and dashed — nothing of the animation is hidden by the plate's bounds. -->
                          <ItemsControl x:Name="PlateOverflow" Tag="PlateOverflow" Classes="canvasItems" ItemsSource="{Binding TemplateOverflow}"
                                        IsVisible="{Binding HasTemplateOverflow}" Height="36" Margin="0,4,0,0" VerticalAlignment="Top" ClipToBounds="False">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas ClipToBounds="False"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Width="{Binding Width}" Height="36" Background="{Binding ColorHex}" Opacity="0.45" CornerRadius="2"
                                        BorderBrush="{Binding ColorHex}" BorderThickness="1" ToolTip.Tip="{Binding Tip}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- D056 §4: the start T of each route area anchored to this clip, a 3 px blue bar with a cap at
                               the bottom (the look the FIT marks of D051 had); it comes and goes with its area. Editor only. -->
                          <ItemsControl Classes="canvasItems" ItemsSource="{Binding RouteStartMarks}" Width="{Binding Width}" Height="36"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Panel Tag="RouteStartMark" Width="9" Height="36" Margin="-4,0,0,0" Background="#01000000"
                                       ToolTip.Tip="{Binding Tip}">
                                  <Border Width="3" Background="#29B6F6" HorizontalAlignment="Center"/>
                                  <Border Classes="fitCap" Width="9" Height="6" Background="#29B6F6" VerticalAlignment="Bottom"/>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- D048 §4.1: the overlay strip on its own thin lane directly above the clip (the row's top 4 px):
                               green, orange over it, lilac on top; its edges and the orange / lilac bodies drag (§4.2), a click
                               selects the orange (§3.9). -->
                          <ItemsControl x:Name="StripLane" Tag="StripLane" Classes="canvasItems" ItemsSource="{Binding StripSegments}"
                                        IsVisible="{Binding ShowsStripLane}" Width="{Binding Width}" Height="4" VerticalAlignment="Top"
                                        HorizontalAlignment="Left" Background="#01000000" Cursor="SizeWestEast" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="stripSegment" Classes.selected="{Binding IsSelected}" Width="{Binding Width}" Height="4"
                                        Background="{Binding ColorHex}" ToolTip.Tip="{Binding Tip}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Dissolve zones (D025 §3) drawn over the clips. The zone itself is not hit-testable: the clips' trim
                         handles stay reachable; a press on a clip body inside a zone selects the dissolve (see the
                         code-behind). Its mark — the type's glyph at the zone's centre, 14 × 14 px — is: it selects the
                         transition even where a short zone is all trim handles (the Phase 28 manual run, D4); above and
                         below the mark the handles trim as before. -->
                    <!-- The owner's acceptance of 2026-11-10: the ghost of a drag from the Media Browser — the dropped files' span;
                         amber when the drop would move other clips. Information only, never hit-tested. -->
                    <Canvas IsHitTestVisible="False" IsVisible="{Binding HasDropGhost}">
                      <Border Canvas.Left="{Binding DropGhostLeft}" Width="{Binding DropGhostWidth}" Height="36" Margin="0,4,0,0"
                              CornerRadius="3" BorderThickness="1" Classes="dropGhost" Classes.movesOthers="{Binding DropGhostMovesOthers}"/>
                    </Canvas>
                    <ItemsControl Classes="canvasItems" ItemsSource="{Binding Transitions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Panel Width="{Binding Width}" Height="36" Margin="0,4,0,0" IsVisible="{Binding IsVisible}">
                            <Border Classes="dissolve" Classes.selected="{Binding IsSelected}" CornerRadius="2" IsHitTestVisible="False"/>
                            <Border x:Name="TransitionMark" Tag="TransitionMark" Width="14" Height="14" Background="#01000000" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding TypeName}">
                              <TextBlock Text="{Binding Glyph}" Foreground="#FFFFFF" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsHitTestVisible="False"/>
                            </Border>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- In / Out range (D030 §8): a shade over the ruler and the tracks, the In / Out lines -->
            <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
              <Rectangle Classes="inOutShade" Classes.current="{Binding IsPlayheadInRange}"
                         Canvas.Left="{Binding RangeLeft}" Width="{Binding RangeWidth}" Height="{Binding PlayheadHeight}"
                         IsVisible="{Binding HasRange}"/>
              <Rectangle Canvas.Left="{Binding InX}" Width="2" Height="{Binding PlayheadHeight}" Fill="#F2C94C"
                         IsVisible="{Binding HasIn}"/>
              <Rectangle Canvas.Left="{Binding OutX}" Width="2" Margin="-2,0,0,0" Height="{Binding PlayheadHeight}" Fill="#F2C94C"
                         IsVisible="{Binding HasOut}"/>
            </Canvas>

            <!-- The range bar on the ruler: In … Out, ✕ clears it (Q11). Its button takes the click; the rest of the ruler
                 still moves the playhead. -->
            <Canvas Grid.Row="0" Height="24" VerticalAlignment="Top">
              <Border Canvas.Left="{Binding RangeLeft}" Width="{Binding RangeWidth}" Height="7" Canvas.Top="17"
                      Background="#B0F2C94C" IsVisible="{Binding HasRange}" IsHitTestVisible="False"/>
              <Button Content="✕" Canvas.Left="{Binding RangeRight}" Canvas.Top="1" Margin="2,0,0,0"
                      FontSize="{DynamicResource FontSizeCaption}" Padding="3,0" MinHeight="0" Height="15" IsVisible="{Binding CanClearRange}"
                      ToolTip.Tip="{x:Static l:Strings.Timeline_ClearInOutTip}" Command="{Binding ClearInOutCommand}"/>
            </Canvas>

            <!-- The marquee (D037 §1), over the lanes -->
            <Canvas Grid.Row="1" IsHitTestVisible="False">
              <Rectangle Canvas.Left="{Binding MarqueeLeft}" Canvas.Top="{Binding MarqueeTop}" Width="{Binding MarqueeWidth}" Height="{Binding MarqueeHeight}"
                         Fill="#334FC3F7" Stroke="#4FC3F7" StrokeThickness="1" IsVisible="{Binding IsMarqueeVisible}"/>
            </Canvas>

            <!-- Playhead and snap indicator overlay, spanning ruler + tracks -->
            <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
              <Rectangle Canvas.Left="{Binding SnapIndicatorX}" Width="1" Height="{Binding PlayheadHeight}"
                         Fill="#4FC3F7" IsVisible="{Binding IsSnapIndicatorVisible}"/>
              <Rectangle Canvas.Left="{Binding PlayheadX}" Width="1" Height="{Binding PlayheadHeight}" Fill="#E05A3C"/>
            </Canvas>

          </Grid>
        </ScrollViewer>

        <!-- Empty timeline (D024 Step 9.8): how to add a clip. Not hit-testable, so drops reach the tracks. -->
        <StackPanel Grid.Column="1" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False" Spacing="4" Margin="16,0,16,28"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <TextBlock Text="{x:Static l:Strings.Timeline_Empty}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static l:Strings.Timeline_EmptyHint}"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

      </Grid>

    </DockPanel>
  </Border>

</UserControl>
