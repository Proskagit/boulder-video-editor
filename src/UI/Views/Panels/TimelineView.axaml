<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:AiVideoEditor.UI.Rendering"
             x:Class="AiVideoEditor.UI.Views.Panels.TimelineView"
             Focusable="True">

  <UserControl.Styles>
    <!-- Items on a Canvas are positioned through their container (ContentPresenter). -->
    <Style Selector="ItemsControl.canvasItems > ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
    </Style>

    <Style Selector="Border.clip">
      <Setter Property="BorderBrush" Value="#000000"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.clip.selected">
      <Setter Property="BorderBrush" Value="#FFD54F"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.clip.invalid">
      <Setter Property="BorderBrush" Value="#E05A3C"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Border.trimHandle">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>
    <Style Selector="Border.trimHandle:pointerover">
      <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>
    <Style Selector="Border.dissolve">
      <Setter Property="Background" Value="#55B0C4DE"/>
      <Setter Property="BorderBrush" Value="#B0C4DE"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.dissolve.selected">
      <Setter Property="BorderBrush" Value="#FFD54F"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.trackRow">
      <Setter Property="Background" Value="#202020"/>
    </Style>
    <Style Selector="Border.trackRow.dropTarget">
      <Setter Property="Background" Value="#2A3A4A"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#1E1E1E" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
    <DockPanel>

      <!-- Header: title, project frame rate, timeline tools -->
      <Border DockPanel.Dock="Top" Padding="8,4" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="TIMELINE" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FrameRateDisplay}" FontSize="11" Foreground="#7A7A7A" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <Button Content="+ Video Track" Command="{Binding AddVideoTrackCommand}" ToolTip.Tip="Add a video track" FontSize="11"/>
            <Button Content="+ Audio Track" Command="{Binding AddAudioTrackCommand}" ToolTip.Tip="Add an audio track" FontSize="11"/>
            <Button Content="+ Text" Command="{Binding AddTextCommand}" ToolTip.Tip="Add a text clip at the playhead on the top video track" FontSize="11"/>
            <Rectangle Width="1" Fill="#444444" Margin="4,2"/>
            <Button Content="Split" Command="{Binding SplitAtPlayheadCommand}" ToolTip.Tip="Split at playhead (S)" FontSize="11"/>
            <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete the selected clips or dissolve (Delete)" FontSize="11"/>
            <Button Content="Ripple Delete" Command="{Binding RippleDeleteCommand}" ToolTip.Tip="Delete the selected clips and move the later clips of their tracks left to close up" FontSize="11"/>
            <Button Content="Close Gap" Command="{Binding CloseGapCommand}" ToolTip.Tip="Remove the empty space before the selected clip: it and the later clips of its track move left" FontSize="11"/>
            <Button Content="Dissolve" Command="{Binding AddDissolveCommand}" ToolTip.Tip="Add a dissolve between the two selected clips (they must meet on a video track)" FontSize="11"/>
            <ToggleButton Content="Snap" IsChecked="{Binding SnappingEnabled}" ToolTip.Tip="Snapping (N)" FontSize="11"/>
            <Rectangle Width="1" Fill="#444444" Margin="4,2"/>
            <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+−)" FontSize="11"/>
            <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl+=)" FontSize="11"/>
            <Button Content="Fit" Command="{Binding ZoomToFitCommand}" ToolTip.Tip="Zoom to fit (\)" FontSize="11"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid ColumnDefinitions="84,*">

        <!-- Track headers: scroll vertically in sync with the tracks (see code-behind). -->
        <ScrollViewer x:Name="HeaderScroll" Grid.Column="0" Background="#252526"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Height="24"/> <!-- spacer matching the ruler -->
            <ItemsControl ItemsSource="{Binding Tracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="44" BorderBrush="#1A1A1A" BorderThickness="0,0,1,1">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Label}" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                      <!-- D027 §3: move among the tracks of its kind, delete (the edit service decides; locks, last track) -->
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <StackPanel.Styles>
                          <Style Selector="Button">
                            <Setter Property="FontSize" Value="9"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Height" Value="16"/>
                          </Style>
                        </StackPanel.Styles>
                        <Button Content="▲" ToolTip.Tip="Move the track up"
                                Command="{Binding $parent[ItemsControl].DataContext.MoveTrackUpCommand}" CommandParameter="{Binding}"/>
                        <Button Content="▼" ToolTip.Tip="Move the track down"
                                Command="{Binding $parent[ItemsControl].DataContext.MoveTrackDownCommand}" CommandParameter="{Binding}"/>
                        <Button Content="✕" ToolTip.Tip="Delete the track (asks first when it has clips)"
                                Command="{Binding $parent[ItemsControl].DataContext.DeleteTrackCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ContentScroll" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="ContentRoot" RowDefinitions="24,Auto" Width="{Binding ContentWidth}"
                HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Time ruler: click / drag to move the playhead -->
            <Panel x:Name="Ruler" Grid.Row="0" Background="#232323" Cursor="Hand">
              <ItemsControl Classes="canvasItems" ItemsSource="{Binding RulerTicks}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Panel>
                      <Rectangle Width="1" Height="6" Fill="#5A5A5A" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                      <TextBlock Text="{Binding Label}" Foreground="#7A7A7A" FontSize="10" Margin="3,4,0,0"/>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>

            <!-- Track lanes with clips -->
            <ItemsControl x:Name="TrackRows" Grid.Row="1" ItemsSource="{Binding Tracks}"
                          DragDrop.AllowDrop="True" Background="#1C1C1C">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackRow" Classes.dropTarget="{Binding IsDropTarget}"
                          Height="44" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                    <Panel>
                    <ItemsControl Classes="canvasItems" ItemsSource="{Binding Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="clip" Classes.selected="{Binding IsSelected}" Classes.invalid="{Binding IsInvalid}"
                                  Width="{Binding Width}" Height="36" Margin="0,4,0,0"
                                  CornerRadius="2" Background="{Binding ColorHex}" ClipToBounds="True">
                            <Grid ColumnDefinitions="6,*,6">
                              <!-- Waveform of the clip's sound (D024 Step 9.5): the whole clip for audio, the lower half for video. -->
                              <rendering:WaveformView Grid.ColumnSpan="3" Waveform="{Binding Waveform}" IsVisible="{Binding HasWaveform}"/>
                              <!-- Fade ramps (D025 §2): the effective fade in / out, darkening toward the clip's edge. -->
                              <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="{Binding FadeInWidth}" IsVisible="{Binding HasFadeIn}"
                                      IsHitTestVisible="False">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#B0000000"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                              <Border Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="{Binding FadeOutWidth}" IsVisible="{Binding HasFadeOut}"
                                      IsHitTestVisible="False">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#B0000000"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#EEEEEE" FontSize="10"
                                         Margin="2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         IsHitTestVisible="False"/>
                              <Border Grid.Column="0" Classes="trimHandle" Tag="TrimStart"/>
                              <Border Grid.Column="2" Classes="trimHandle" Tag="TrimEnd"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Dissolve zones (D025 §3) drawn over the clips. Not hit-testable: the clips' trim handles stay
                         reachable; a press on a clip body inside a zone selects the dissolve (see the code-behind). -->
                    <ItemsControl Classes="canvasItems" ItemsSource="{Binding Transitions}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="dissolve" Classes.selected="{Binding IsSelected}" Width="{Binding Width}" Height="36"
                                  Margin="0,4,0,0" CornerRadius="2" IsVisible="{Binding IsVisible}">
                            <TextBlock Text="⨯" Foreground="#FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Playhead and snap indicator overlay, spanning ruler + tracks -->
            <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
              <Rectangle Canvas.Left="{Binding SnapIndicatorX}" Width="1" Height="{Binding PlayheadHeight}"
                         Fill="#4FC3F7" IsVisible="{Binding IsSnapIndicatorVisible}"/>
              <Rectangle Canvas.Left="{Binding PlayheadX}" Width="1" Height="{Binding PlayheadHeight}" Fill="#E05A3C"/>
            </Canvas>

          </Grid>
        </ScrollViewer>

        <!-- Empty timeline (D024 Step 9.8): how to add a clip. Not hit-testable, so drops reach the tracks. -->
        <StackPanel Grid.Column="1" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False" Spacing="4" Margin="16,0,16,28"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <TextBlock Text="The timeline is empty" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center"/>
          <TextBlock Text="Drag media here from the Media Browser, or select it and click Add to Timeline. + Text adds a text clip."
                     Foreground="#7A7A7A" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

      </Grid>

    </DockPanel>
  </Border>

</UserControl>
