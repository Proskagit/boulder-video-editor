<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.Panels.PreviewView">

  <Grid RowDefinitions="*,Auto" Background="#1E1E1E">

    <!-- Video canvas, kept at a 16:9 box via a fixed-ratio Viewbox. Frames are letterboxed
         inside it; the image is filled from the view model's DecodedFrame in code-behind. -->
    <Border Grid.Row="0" Margin="16">
      <Viewbox Stretch="Uniform">
        <Border Width="960" Height="540" Background="#000000" BorderBrush="#3A3A3A" BorderThickness="1">
          <Grid>
            <Image x:Name="FrameImage" Stretch="Uniform"/>
            <TextBlock Text="{Binding PlaceholderText}"
                       IsVisible="{Binding PlaceholderText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="#9A9A9A" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="Buffering…" IsVisible="{Binding IsBuffering}"
                       Foreground="#7A7A7A" FontSize="12" Margin="8"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
        </Border>
      </Viewbox>
    </Border>

    <!-- Transport controls -->
    <Border Grid.Row="1" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="⏮" Command="{Binding PreviousFrameCommand}" ToolTip.Tip="Previous frame"/>
        <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="64"/>
        <Button Content="⏹" Command="{Binding StopCommand}" ToolTip.Tip="Stop"/>
        <Button Content="⏭" Command="{Binding NextFrameCommand}" ToolTip.Tip="Next frame"/>

        <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock Text="/" Foreground="#6A6A6A" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DurationDisplay}" Foreground="#8A8A8A" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
