<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:AiVideoEditor.UI.Rendering"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             x:Class="AiVideoEditor.UI.Views.Panels.PreviewView">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Background="#1E1E1E">

    <!-- Timeline / Source (Phase 16, D031 SQ1): one panel, two modes; Source plays the asset opened from the Media
         Browser (double click). -->
    <Border Grid.Row="0" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="2" DockPanel.Dock="Left">
          <StackPanel.Styles>
            <Style Selector="Button.mode">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="8,2"/>
            </Style>
            <Style Selector="Button.mode.shown /template/ ContentPresenter">
              <Setter Property="Background" Value="#0E639C"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
          </StackPanel.Styles>
          <Button Classes="mode" Classes.shown="{Binding IsTimelineMode}" Content="Timeline"
                  Command="{Binding ShowTimelineCommand}" ToolTip.Tip="Show the timeline at its playhead"/>
          <Button Classes="mode" Classes.shown="{Binding IsSourceMode}" Content="Source"
                  Command="{Binding ShowSourceCommand}"
                  ToolTip.Tip="Show the media opened in Source (double-click a video or audio file in the Media Browser)"/>
        </StackPanel>
        <!-- Move / Crop (Phase 23, D038 §1): two exclusive tools over the timeline's picture; off in Source mode and
             during an export. -->
        <StackPanel Orientation="Horizontal" Spacing="2" DockPanel.Dock="Right" Margin="8,0,0,0"
                    IsVisible="{Binding Transform, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel.Styles>
            <Style Selector="ToggleButton.tool">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="8,2"/>
            </Style>
          </StackPanel.Styles>
          <ToggleButton Classes="tool" Content="Move" IsChecked="{Binding Transform.IsMoveOn, Mode=TwoWay}"
                        IsEnabled="{Binding Transform.IsAvailable, FallbackValue=False}"
                        ToolTip.Tip="Drag the selected clip in the picture; drag a corner of its frame to scale it (Esc cancels a drag)"/>
          <ToggleButton Classes="tool" Content="Crop" IsChecked="{Binding Transform.IsCropOn, Mode=TwoWay}"
                        IsEnabled="{Binding Transform.IsAvailable, FallbackValue=False}"
                        ToolTip.Tip="Drag the handles of the selected clip's frame to crop it; the picture stays in place (Esc cancels a drag)"/>
        </StackPanel>
        <!-- AI hold markup (Phase 19, D034): the mode's status and buttons live in this bar, so the picture keeps its
             size and nothing covers a hold. -->
        <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" Margin="8,0,0,0"
                    IsVisible="{Binding HoldMarkup.IsActive, FallbackValue=False}">
          <TextBlock Text="{Binding HoldMarkup.AlternativeText}" Foreground="#00E5FF" FontSize="11" VerticalAlignment="Center"
                     IsVisible="{Binding HoldMarkup.AlternativeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <ProgressBar IsVisible="{Binding HoldMarkup.IsPreparing}" Minimum="0" Maximum="1" Width="80" Height="4"
                       Value="{Binding HoldMarkup.PrepareProgress}" VerticalAlignment="Center"/>
          <ToggleButton Content="Loupe" FontSize="11" Padding="6,2" IsChecked="{Binding HoldMarkup.IsLoupeOn, Mode=TwoWay}"
                        IsVisible="{Binding !HoldMarkup.IsPreparing}" ToolTip.Tip="A magnified view of the frame under the pointer"/>
          <Button Content="Confirm" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.ConfirmCommand}"
                  IsVisible="{Binding !HoldMarkup.IsPreparing}" ToolTip.Tip="Confirm the hold (Enter)"/>
          <Button Content="Cancel" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.EscapeCommand}"
                  IsVisible="{Binding HoldMarkup.IsPreparing}" ToolTip.Tip="Stop preparing the frame (Esc)"/>
          <Button Content="Done" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.DoneCommand}"
                  ToolTip.Tip="Leave the hold markup (the marked holds stay)"/>
        </StackPanel>
        <Panel Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SourceName}" Foreground="#9A9A9A" FontSize="11" TextTrimming="CharacterEllipsis">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HoldMarkup.IsActive" Converter="{x:Static BoolConverters.Not}" FallbackValue="True"/>
                <Binding Path="Transform.IsActive" Converter="{x:Static BoolConverters.Not}" FallbackValue="True"/>
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <TextBlock Text="{Binding Transform.ModeText}" Foreground="#DDDDDD" FontSize="11" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Transform.IsActive, FallbackValue=False}"/>
          <TextBlock Text="{Binding HoldMarkup.ModeText}" Foreground="#DDDDDD" FontSize="11" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding HoldMarkup.ModeHelp}"
                     IsVisible="{Binding HoldMarkup.IsActive, FallbackValue=False}"/>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Composition (Phase 7 Step 7): the project canvas with its real proportions, letterboxed
         in the available space; every layer is drawn by CompositionView (D018/D019). -->
    <Grid Grid.Row="1" Margin="16">
      <rendering:CompositionView Layers="{Binding Layers}" Canvas="{Binding Canvas}"/>
      <!-- AI hold markup (Phase 19, D034): clicks, the candidate, the selected hold and the loupe (status and buttons in
           the bar above). -->
      <rendering:HoldMarkupOverlay Markup="{Binding HoldMarkup}"/>
      <!-- Move / Crop (Phase 23, D038): the selected clip's frame and handles, clicks and drags (text in the bar above). -->
      <rendering:PreviewTransformOverlay Transform="{Binding Transform}" Layers="{Binding Layers}"/>
      <TextBlock Text="Buffering…" IsVisible="{Binding IsBuffering}"
                 Foreground="#7A7A7A" FontSize="12" Margin="8"
                 HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>

    <!-- The source bar (Source mode only): position and In / Out on the asset, Insert (,) / Overwrite (.). -->
    <Border Grid.Row="2" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8,4"
            IsVisible="{Binding IsSourceMode}">
      <StackPanel Spacing="4">
        <controls:SourceRangeBar x:Name="SourceBar" Height="16" Cursor="Hand"
                                 Frames="{Binding SourceFrames}" Frame="{Binding SourceFrame}"
                                 InFrame="{Binding SourceInFrame}" OutFrame="{Binding SourceOutFrame}"/>
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right">
            <ToggleButton Content="Sound only" FontSize="11" Padding="6,2" IsVisible="{Binding CanSourceSoundOnly}"
                          IsChecked="{Binding IsSourceSoundOnly, Mode=TwoWay}"
                          ToolTip.Tip="Insert / Overwrite only the sound of this video, as an audio clip on the target audio track"/>
            <Button Content="Insert" FontSize="11" Padding="6,2" Command="{Binding InsertCommand}"
                    ToolTip.Tip="Insert the source range at the playhead on the target track (,)"/>
            <Button Content="Overwrite" FontSize="11" Padding="6,2" Command="{Binding OverwriteCommand}"
                    ToolTip.Tip="Overwrite the target track with the source range from the playhead (.)"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="In" FontSize="11" Padding="6,2" Command="{Binding SetSourceInCommand}" ToolTip.Tip="Source In (I)"/>
            <Button Content="Out" FontSize="11" Padding="6,2" Command="{Binding SetSourceOutCommand}" ToolTip.Tip="Source Out (O)"/>
            <TextBlock Text="{Binding SourceRangeDisplay}" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"
                       Margin="4,0,0,0"/>
            <Button Content="✕" FontSize="10" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding HasSourceRange}"
                    Command="{Binding ClearSourceRangeCommand}" ToolTip.Tip="Clear the source In / Out"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Transport controls -->
    <Border Grid.Row="3" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="⏮" Command="{Binding PreviousFrameCommand}" ToolTip.Tip="Previous frame (←)"/>
        <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="64"
                ToolTip.Tip="Play / Pause (Space; L plays, K pauses, J one second back)"/>
        <Button Content="⏹" Command="{Binding StopCommand}" ToolTip.Tip="Stop"/>
        <Button Content="⏭" Command="{Binding NextFrameCommand}" ToolTip.Tip="Next frame (→)"/>
        <ToggleButton Content="Loop" IsChecked="{Binding IsLooping, Mode=TwoWay}" ToolTip.Tip="Loop playback (Ctrl+L)"/>

        <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock Text="/" Foreground="#6A6A6A" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DurationDisplay}" Foreground="#8A8A8A" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
