<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:AiVideoEditor.UI.Rendering"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             x:Class="AiVideoEditor.UI.Views.Panels.PreviewView">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Background="#1E1E1E">

    <!-- Timeline / Source (Phase 16, D031 SQ1): one panel, two modes; Source plays the asset opened from the Media
         Browser (double click). -->
    <Border Grid.Row="0" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="2" DockPanel.Dock="Left">
          <StackPanel.Styles>
            <Style Selector="Button.mode">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="8,2"/>
            </Style>
            <Style Selector="Button.mode.shown /template/ ContentPresenter">
              <Setter Property="Background" Value="#0E639C"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
          </StackPanel.Styles>
          <Button Classes="mode" Classes.shown="{Binding IsTimelineMode}" Content="{x:Static l:Strings.Preview_TimelineMode}"
                  Command="{Binding ShowTimelineCommand}" ToolTip.Tip="{x:Static l:Strings.Preview_TimelineModeTip}"/>
          <Button Classes="mode" Classes.shown="{Binding IsSourceMode}" Content="{x:Static l:Strings.Preview_SourceMode}"
                  Command="{Binding ShowSourceCommand}"
                  ToolTip.Tip="{x:Static l:Strings.Preview_SourceModeTip}"/>
        </StackPanel>
        <!-- Move / Crop (Phase 23, D038 §1): two exclusive tools over the timeline's picture; off in Source mode and
             during an export. -->
        <StackPanel Orientation="Horizontal" Spacing="2" DockPanel.Dock="Right" Margin="8,0,0,0"
                    IsVisible="{Binding Transform, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel.Styles>
            <Style Selector="ToggleButton.tool">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="8,2"/>
            </Style>
          </StackPanel.Styles>
          <ToggleButton Classes="tool" IsChecked="{Binding Transform.IsMoveOn, Mode=TwoWay}"
                        IsEnabled="{Binding Transform.IsAvailable, FallbackValue=False}"
                        ToolTip.Tip="{x:Static l:Strings.Preview_MoveTip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:IconPath Glyph="{x:Static controls:Icons.Move}" Width="12" Height="12"/>
              <TextBlock Text="{x:Static l:Strings.Preview_Move}"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="tool" IsChecked="{Binding Transform.IsCropOn, Mode=TwoWay}"
                        IsEnabled="{Binding Transform.IsAvailable, FallbackValue=False}"
                        ToolTip.Tip="{x:Static l:Strings.Preview_CropTip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:IconPath Glyph="{x:Static controls:Icons.Crop}" Width="12" Height="12"/>
              <TextBlock Text="{x:Static l:Strings.Preview_Crop}"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <!-- AI hold markup (Phase 19, D034): the mode's status and buttons live in this bar, so the picture keeps its
             size and nothing covers a hold. -->
        <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" Margin="8,0,0,0"
                    IsVisible="{Binding HoldMarkup.IsActive, FallbackValue=False}">
          <TextBlock Text="{Binding HoldMarkup.AlternativeText}" Foreground="#00E5FF" FontSize="11" VerticalAlignment="Center"
                     IsVisible="{Binding HoldMarkup.AlternativeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <ProgressBar IsVisible="{Binding HoldMarkup.IsPreparing}" Minimum="0" Maximum="1" Width="80" Height="4"
                       Value="{Binding HoldMarkup.PrepareProgress}" VerticalAlignment="Center"/>
          <ToggleButton Content="{x:Static l:Strings.Holds_Loupe}" FontSize="11" Padding="6,2" IsChecked="{Binding HoldMarkup.IsLoupeOn, Mode=TwoWay}"
                        IsVisible="{Binding !HoldMarkup.IsPreparing}" ToolTip.Tip="{x:Static l:Strings.Holds_LoupeTip}"/>
          <Button Content="{x:Static l:Strings.Holds_Confirm}" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.ConfirmCommand}"
                  IsVisible="{Binding !HoldMarkup.IsPreparing}" ToolTip.Tip="{x:Static l:Strings.Holds_ConfirmTip}"/>
          <Button Content="{x:Static l:Strings.Common_Cancel}" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.EscapeCommand}"
                  IsVisible="{Binding HoldMarkup.IsPreparing}" ToolTip.Tip="{x:Static l:Strings.Holds_CancelTip}"/>
          <Button Content="{x:Static l:Strings.Holds_Done}" FontSize="11" Padding="6,2" Command="{Binding HoldMarkup.DoneCommand}"
                  ToolTip.Tip="{x:Static l:Strings.Holds_DoneTip}"/>
        </StackPanel>
        <Panel Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SourceName}" Foreground="#9A9A9A" FontSize="11" TextTrimming="CharacterEllipsis">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HoldMarkup.IsActive" Converter="{x:Static BoolConverters.Not}" FallbackValue="True"/>
                <Binding Path="Transform.IsActive" Converter="{x:Static BoolConverters.Not}" FallbackValue="True"/>
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <TextBlock Text="{Binding Transform.ModeText}" Foreground="#DDDDDD" FontSize="11" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Transform.IsActive, FallbackValue=False}"/>
          <TextBlock Text="{Binding HoldMarkup.ModeText}" Foreground="#DDDDDD" FontSize="11" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding HoldMarkup.ModeHelp}"
                     IsVisible="{Binding HoldMarkup.IsActive, FallbackValue=False}"/>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Composition (Phase 7 Step 7): the project canvas with its real proportions, letterboxed
         in the available space; every layer is drawn by CompositionView (D018/D019). -->
    <Grid Grid.Row="1" Margin="16">
      <rendering:CompositionView Layers="{Binding Layers}" Canvas="{Binding Canvas}"/>
      <!-- AI hold markup (Phase 19, D034): clicks, the candidate, the selected hold and the loupe (status and buttons in
           the bar above). -->
      <rendering:HoldMarkupOverlay Markup="{Binding HoldMarkup}"/>
      <!-- Move / Crop (Phase 23, D038): the selected clip's frame and handles, clicks and drags (text in the bar above); it
           reaches over the picture's 16 px margin (PreviewTransformOverlay.Inset) so handles on the canvas edge are whole. -->
      <rendering:PreviewTransformOverlay Transform="{Binding Transform}" Layers="{Binding Layers}" Margin="-16"/>
      <TextBlock Text="{x:Static l:Strings.Preview_Buffering}" IsVisible="{Binding IsBuffering}"
                 Foreground="#7A7A7A" FontSize="12" Margin="8"
                 HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>

    <!-- The source bar (Source mode only): position and In / Out on the asset, Insert (,) / Overwrite (.). -->
    <Border Grid.Row="2" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8,4"
            IsVisible="{Binding IsSourceMode}">
      <StackPanel Spacing="4">
        <controls:SourceRangeBar x:Name="SourceBar" Height="16" Cursor="Hand"
                                 Frames="{Binding SourceFrames}" Frame="{Binding SourceFrame}"
                                 InFrame="{Binding SourceInFrame}" OutFrame="{Binding SourceOutFrame}"/>
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right">
            <ToggleButton Content="{x:Static l:Strings.Source_SoundOnly}" FontSize="11" Padding="6,2" IsVisible="{Binding CanSourceSoundOnly}"
                          IsChecked="{Binding IsSourceSoundOnly, Mode=TwoWay}"
                          ToolTip.Tip="{x:Static l:Strings.Source_SoundOnlyTip}"/>
            <Button Content="{x:Static l:Strings.Source_Insert}" FontSize="11" Padding="6,2" Command="{Binding InsertCommand}"
                    ToolTip.Tip="{x:Static l:Strings.Source_InsertTip}"/>
            <Button Content="{x:Static l:Strings.Source_Overwrite}" FontSize="11" Padding="6,2" Command="{Binding OverwriteCommand}"
                    ToolTip.Tip="{x:Static l:Strings.Source_OverwriteTip}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="{x:Static l:Strings.Source_In}" FontSize="11" Padding="6,2" Command="{Binding SetSourceInCommand}" ToolTip.Tip="{x:Static l:Strings.Source_InTip}"/>
            <Button Content="{x:Static l:Strings.Source_Out}" FontSize="11" Padding="6,2" Command="{Binding SetSourceOutCommand}" ToolTip.Tip="{x:Static l:Strings.Source_OutTip}"/>
            <TextBlock Text="{Binding SourceRangeDisplay}" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"
                       Margin="4,0,0,0"/>
            <Button Content="✕" FontSize="10" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding HasSourceRange}"
                    Command="{Binding ClearSourceRangeCommand}" ToolTip.Tip="{x:Static l:Strings.Source_ClearRangeTip}"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Transport controls -->
    <Border Grid.Row="3" Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <!-- D039 §7: the transport as icons (Play / Pause one button of one width); names and shortcuts in the tooltips. -->
        <Button Command="{Binding PreviousFrameCommand}" ToolTip.Tip="{x:Static l:Strings.Transport_PrevTip}" Padding="10,6">
          <controls:IconPath Glyph="{x:Static controls:Icons.PreviousFrame}" Filled="True"/>
        </Button>
        <Button x:Name="PlayPauseButton" Command="{Binding PlayPauseCommand}" MinWidth="48" Padding="10,6"
                ToolTip.Tip="{x:Static l:Strings.Transport_PlayPauseTip}" AutomationProperties.Name="{Binding PlayPauseLabel}">
          <Panel>
            <controls:IconPath Glyph="{x:Static controls:Icons.Play}" Filled="True" IsVisible="{Binding !IsPlaying}"/>
            <controls:IconPath Glyph="{x:Static controls:Icons.Pause}" StrokeThickness="2.5" IsVisible="{Binding IsPlaying}"/>
          </Panel>
        </Button>
        <Button Command="{Binding StopCommand}" ToolTip.Tip="{x:Static l:Strings.Transport_StopTip}" Padding="10,6">
          <controls:IconPath Glyph="{x:Static controls:Icons.Stop}" Filled="True"/>
        </Button>
        <Button Command="{Binding NextFrameCommand}" ToolTip.Tip="{x:Static l:Strings.Transport_NextTip}" Padding="10,6">
          <controls:IconPath Glyph="{x:Static controls:Icons.NextFrame}" Filled="True"/>
        </Button>
        <!-- An icon only, as the others: with a label the timecode no longer fits the Preview at 1024 px (D039 §7). -->
        <ToggleButton IsChecked="{Binding IsLooping, Mode=TwoWay}" ToolTip.Tip="{x:Static l:Strings.Transport_LoopTip}" Padding="10,6"
                      AutomationProperties.Name="{x:Static l:Strings.Transport_Loop}">
          <controls:IconPath Glyph="{x:Static controls:Icons.Loop}"/>
        </ToggleButton>

        <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBlock Text="/" Foreground="#6A6A6A" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DurationDisplay}" Foreground="#8A8A8A" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
