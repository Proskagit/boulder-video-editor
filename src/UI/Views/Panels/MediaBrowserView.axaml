<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:AiVideoEditor.UI.Rendering"
             x:Class="AiVideoEditor.UI.Views.Panels.MediaBrowserView">

  <Border Background="#252526" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <DockPanel>
          <TextBlock Text="{x:Static l:Strings.Media_Heading}" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A"
                     VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <Button Content="{x:Static l:Strings.Media_AddToTimeline}" Command="{Binding AddToTimelineCommand}"
                    ToolTip.Tip="{x:Static l:Strings.Media_AddToTimelineTip}"/>
            <Button Content="{x:Static l:Strings.Media_Import}" Command="{Binding ImportCommand}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Offline media (Phase 11 Step 11.6, D026 §5): shown only while some media is offline. -->
      <Border DockPanel.Dock="Top" Padding="8,4,8,6" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
              IsVisible="{Binding HasOfflineMedia}">
        <DockPanel>
          <TextBlock Text="{x:Static l:Strings.Media_Offline}" FontSize="10" FontWeight="Bold" Foreground="#C0864A"
                     VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <Button Content="{x:Static l:Strings.Media_Relink}" Command="{Binding RelinkCommand}"
                    ToolTip.Tip="{x:Static l:Strings.Media_RelinkTip}"/>
            <Button Content="{x:Static l:Strings.Media_FindMissing}" Command="{Binding FindMissingCommand}"
                    ToolTip.Tip="{x:Static l:Strings.Media_FindMissingTip}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel>
        <!-- Empty state -->
        <StackPanel IsVisible="{Binding HasNoMedia}" Margin="16" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{x:Static l:Strings.Media_Empty}" Foreground="#AAAAAA" FontSize="13"
                     HorizontalAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="{x:Static l:Strings.Media_EmptyHint}"
                     Foreground="#6A6A6A" FontSize="11" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- Real media list -->
        <ListBox x:Name="MediaList"
                 IsVisible="{Binding !HasNoMedia}"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <!-- D027 §4: remove the selected media from the project (the view model asks when clips use it). -->
                <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="5,1" VerticalAlignment="Center"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                        Command="{Binding $parent[ListBox].DataContext.RemoveCommand}"
                        ToolTip.Tip="{x:Static l:Strings.Media_RemoveTip}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">

                  <!-- The kind's colour is the placeholder; a thumbnail, once ready, is drawn over it (D024 Step 9.4). -->
                  <Border Width="56" Height="32" CornerRadius="2" ClipToBounds="True" Background="{Binding ThumbnailColorHex}">
                    <Image IsVisible="{Binding HasThumbnail}" Stretch="Uniform"
                           Source="{Binding Thumbnail, Converter={x:Static rendering:ThumbnailBitmapConverter.Instance}}"/>
                  </Border>

                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="#DDDDDD" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding KindLabel}" Foreground="#8A8A8A" FontSize="10"/>
                      <TextBlock Text="{Binding FormatAndSizeDisplay}" Foreground="#8A8A8A" FontSize="10"/>
                    </StackPanel>
                    <TextBlock IsVisible="{Binding HasTechnicalSummary}"
                               Text="{Binding TechnicalSummary}" Foreground="#7A7A7A" FontSize="10"/>
                  </StackPanel>

                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>

    </DockPanel>
  </Border>

</UserControl>
