<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             x:Class="AiVideoEditor.UI.Views.Panels.ToolbarView">

  <Border Background="#2D2D30" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="8,6">
    <!-- D039 §6: the commands wrap onto a second row rather than push the window's layout wider (Russian labels are longer). -->
    <WrapPanel Orientation="Horizontal">
      <WrapPanel.Styles>
        <Style Selector="WrapPanel > Button, WrapPanel > DropDownButton">
          <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="WrapPanel > Rectangle">
          <Setter Property="Width" Value="1"/>
          <Setter Property="Height" Value="22"/>
          <Setter Property="Fill" Value="#444444"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
      </WrapPanel.Styles>

      <Button Content="{x:Static l:Strings.Toolbar_New}" Command="{Binding NewProjectCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_NewTip}"/>
      <Button Content="{x:Static l:Strings.Toolbar_Open}" Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_OpenTip}"/>

      <!-- Recent ▾ (D026 §6, Step 11.8): read again and checked each time it opens; see RecentProjectsViewModel. -->
      <DropDownButton x:Name="RecentButton" Content="{x:Static l:Strings.Toolbar_Recent}" DataContext="{Binding Recent}"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                      IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{x:Static l:Strings.Toolbar_RecentTip}">
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <!-- 400: inside the Fluent flyout's maximum width (456 with its padding), so the ✕ column is never cut off. -->
            <StackPanel Width="400" Spacing="2">
              <TextBlock Text="{x:Static l:Strings.Recent_Heading}" FontSize="10" FontWeight="Bold" Foreground="#9A9A9A" Margin="6,2,6,4"/>
              <TextBlock Text="{x:Static l:Strings.Recent_Empty}"
                         IsVisible="{Binding IsEmpty}" Foreground="#AAAAAA" FontSize="12"
                         TextWrapping="Wrap" Margin="6,2,6,6"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <Button Grid.Column="0" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding ToolTip}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" Padding="6,3">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="#8A8A8A"
                                       TextTrimming="PrefixCharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" Foreground="#C0864A"
                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                              ToolTip.Tip="{x:Static l:Strings.Recent_RemoveTip}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Content="{x:Static l:Strings.Toolbar_Save}" Command="{Binding SaveCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_SaveTip}"/>
      <Button Content="{x:Static l:Strings.Toolbar_SaveAs}" Command="{Binding SaveAsCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_SaveAsTip}"/>

      <Rectangle/>

      <!-- D039 §7: Undo / Redo as icons (as in every editor); the name and the shortcut in the tooltip. -->
      <Button Command="{Binding UndoCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_UndoTip}" AutomationProperties.Name="{x:Static l:Strings.Toolbar_Undo}">
        <controls:IconPath Glyph="{x:Static controls:Icons.Undo}"/>
      </Button>
      <Button Command="{Binding RedoCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_RedoTip}" AutomationProperties.Name="{x:Static l:Strings.Toolbar_Redo}">
        <controls:IconPath Glyph="{x:Static controls:Icons.Redo}"/>
      </Button>

      <Rectangle/>

      <Button Content="{x:Static l:Strings.Toolbar_Import}" Command="{Binding ImportMediaCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_ImportTip}"/>

      <Rectangle/>

      <!-- Project Settings… (D028, Step 13.6): canvas size and frame rate; the tooltip shows the current ones. -->
      <Button x:Name="ProjectSettingsButton" Content="{x:Static l:Strings.Toolbar_ProjectSettings}" Command="{Binding ProjectSettingsCommand}"
              ToolTip.Tip="{Binding ProjectSettingsToolTip}"/>

      <Rectangle/>

      <Button Content="{x:Static l:Strings.Toolbar_Export}" Command="{Binding ExportCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_ExportTip}"/>

    </WrapPanel>
  </Border>

</UserControl>
