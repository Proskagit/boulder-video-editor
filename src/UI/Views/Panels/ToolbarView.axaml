<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.Panels.ToolbarView">

  <Border Background="#2D2D30" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="8,6">
    <StackPanel Orientation="Horizontal" Spacing="6">

      <Button Content="New" Command="{Binding NewProjectCommand}" ToolTip.Tip="New Project (Ctrl+N)"/>
      <Button Content="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open Project (Ctrl+O)"/>

      <!-- Recent ▾ (D026 §6, Step 11.8): read again and checked each time it opens; see RecentProjectsViewModel. -->
      <DropDownButton x:Name="RecentButton" Content="Recent" DataContext="{Binding Recent}"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                      IsEnabled="{Binding IsEnabled}" ToolTip.Tip="Open a recent project">
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <!-- 400: inside the Fluent flyout's maximum width (456 with its padding), so the ✕ column is never cut off. -->
            <StackPanel Width="400" Spacing="2">
              <TextBlock Text="RECENT PROJECTS" FontSize="10" FontWeight="Bold" Foreground="#9A9A9A" Margin="6,2,6,4"/>
              <TextBlock Text="No recent projects yet. Projects you open or save appear here."
                         IsVisible="{Binding IsEmpty}" Foreground="#AAAAAA" FontSize="12"
                         TextWrapping="Wrap" Margin="6,2,6,6"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <Button Grid.Column="0" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding ToolTip}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" Padding="6,3">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="#8A8A8A"
                                       TextTrimming="PrefixCharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" Foreground="#C0864A"
                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                              ToolTip.Tip="Remove from the list (the project itself is not changed)"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save Project (Ctrl+S)"/>
      <Button Content="Save As" Command="{Binding SaveAsCommand}" ToolTip.Tip="Save Project As (Ctrl+Shift+S)"/>

      <Rectangle Width="1" Fill="#444444" Margin="6,2"/>

      <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"/>
      <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"/>

      <Rectangle Width="1" Fill="#444444" Margin="6,2"/>

      <Button Content="Import Media" Command="{Binding ImportMediaCommand}" ToolTip.Tip="Import media into the project (Ctrl+I)"/>

      <Rectangle Width="1" Fill="#444444" Margin="6,2"/>

      <!-- Project Settings… (D028, Step 13.6): canvas size and frame rate; the tooltip shows the current ones. -->
      <Button x:Name="ProjectSettingsButton" Content="Project Settings…" Command="{Binding ProjectSettingsCommand}"
              ToolTip.Tip="{Binding ProjectSettingsToolTip}"/>

      <Rectangle Width="1" Fill="#444444" Margin="6,2"/>

      <Button Content="Export" Command="{Binding ExportCommand}" ToolTip.Tip="Export the sequence (Ctrl+E)"/>

    </StackPanel>
  </Border>

</UserControl>
