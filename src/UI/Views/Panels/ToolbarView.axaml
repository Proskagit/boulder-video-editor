<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AiVideoEditor.UI.Controls"
             x:Class="AiVideoEditor.UI.Views.Panels.ToolbarView">

  <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
    <DockPanel>
    <!-- D068 item 11: the project's save state, at the right end of the bar. -->
    <TextBlock x:Name="SaveStateText" DockPanel.Dock="Right" DataContext="{Binding SaveState}"
               IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding Text}" ToolTip.Tip="{Binding ToolTip}" VerticalAlignment="Center" Margin="12,0,4,0"
               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
               Classes.unsaved="{Binding HasUnsavedChanges}">
      <TextBlock.Styles>
        <Style Selector="TextBlock.unsaved"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></Style>
      </TextBlock.Styles>
    </TextBlock>
    <!-- D039 §6: the commands wrap onto a second row rather than push the window's layout wider (Russian labels are longer). -->
    <WrapPanel Orientation="Horizontal">
      <WrapPanel.Styles>
        <Style Selector="WrapPanel > Button, WrapPanel > DropDownButton">
          <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="WrapPanel > Rectangle">
          <Setter Property="Width" Value="1"/>
          <Setter Property="Height" Value="22"/>
          <Setter Property="Fill" Value="{DynamicResource ControlBorderBrush}"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
      </WrapPanel.Styles>

      <Button Content="{x:Static l:Strings.Toolbar_New}" Command="{Binding NewProjectCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_NewTip}"/>
      <Button Content="{x:Static l:Strings.Toolbar_Open}" Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_OpenTip}"/>

      <!-- Recent ▾ (D026 §6, Step 11.8): read again and checked each time it opens; see RecentProjectsViewModel. -->
      <DropDownButton x:Name="RecentButton" Content="{x:Static l:Strings.Toolbar_Recent}" DataContext="{Binding Recent}"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                      IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{x:Static l:Strings.Toolbar_RecentTip}">
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <!-- 400: inside the Fluent flyout's maximum width (456 with its padding), so the ✕ column is never cut off. -->
            <StackPanel Width="400" Spacing="2">
              <TextBlock Text="{x:Static l:Strings.Recent_Heading}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,2,6,4"/>
              <TextBlock Text="{x:Static l:Strings.Recent_Empty}"
                         IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"
                         TextWrapping="Wrap" Margin="6,2,6,6"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <Button Grid.Column="0" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding ToolTip}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="Transparent" Padding="6,3">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderPath}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="PrefixCharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource WarningTextBrush}"
                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                              ToolTip.Tip="{x:Static l:Strings.Recent_RemoveTip}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Content="{x:Static l:Strings.Toolbar_Save}" Command="{Binding SaveCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_SaveTip}"/>
      <Button Content="{x:Static l:Strings.Toolbar_SaveAs}" Command="{Binding SaveAsCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_SaveAsTip}"/>

      <Rectangle/>

      <!-- D039 §7: Undo / Redo as icons (as in every editor); the name and the shortcut in the tooltip. -->
      <Button Command="{Binding UndoCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_UndoTip}" AutomationProperties.Name="{x:Static l:Strings.Toolbar_Undo}">
        <controls:IconPath Glyph="{x:Static controls:Icons.Undo}"/>
      </Button>
      <Button Command="{Binding RedoCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_RedoTip}" AutomationProperties.Name="{x:Static l:Strings.Toolbar_Redo}">
        <controls:IconPath Glyph="{x:Static controls:Icons.Redo}"/>
      </Button>

      <Rectangle/>

      <!-- The owner's acceptance of Phase 38 (2026-11-10, D057 §7.13): no «Импорт медиа» here — the Media Browser's «+ Импорт»
           and Ctrl+I import. -->
      <!-- Phase 35 (D049, D050 amendment B3), Phase 43 (D062): the project's FIT training — import, point to its file, remove.
           The training's clock correction (W − C, the whole training) is in the settings' FIT section (D062 amendment 1). -->
      <DropDownButton x:Name="TrainingButton" Content="{x:Static l:Strings.Toolbar_Training}" ToolTip.Tip="{Binding TrainingToolTip}">
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Width="320" Spacing="4">
              <Button Content="{x:Static l:Strings.Toolbar_TrainingImport}" Command="{Binding ImportTrainingCommand}" HorizontalAlignment="Stretch"/>
              <Button Content="{x:Static l:Strings.Toolbar_TrainingRelink}" Command="{Binding RelinkTrainingCommand}" HorizontalAlignment="Stretch"
                      IsVisible="{Binding $self.IsEnabled}"/>
              <Button Content="{x:Static l:Strings.Toolbar_TrainingRemove}" Command="{Binding RemoveTrainingCommand}" HorizontalAlignment="Stretch"/>
              <!-- D062 amendment 1: the training's clock correction and the FIT settings are in «Настройки» → «FIT-тренировки».
                   D051 §5.7: the declined FIT climbs, each with «Вернуть». -->
              <StackPanel Spacing="2" Margin="0,6,0,0" IsVisible="{Binding HasDeclinedClimbs}">
                <TextBlock Text="{x:Static l:Strings.Toolbar_DeclinedClimbs}" FontSize="{DynamicResource FontSizeCaption}"/>
                <ItemsControl ItemsSource="{Binding DeclinedClimbs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="{x:Static l:Strings.Toolbar_Restore}" Command="{Binding Restore}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>

      <Rectangle/>

      <!-- Project Settings… (D028, Step 13.6): canvas size and frame rate; the tooltip shows the current ones. -->
      <Button x:Name="ProjectSettingsButton" Content="{x:Static l:Strings.Toolbar_ProjectSettings}" Command="{Binding ProjectSettingsCommand}"
              ToolTip.Tip="{Binding ProjectSettingsToolTip}"/>

      <Rectangle/>

      <!-- D068 item 2: the main action of the window — the one accent. -->
      <Button x:Name="ExportButton" Classes="accent" Content="{x:Static l:Strings.Toolbar_Export}" Command="{Binding ExportCommand}" ToolTip.Tip="{x:Static l:Strings.Toolbar_ExportTip}"/>

      <Rectangle IsVisible="{Binding HasAppSettings}"/>

      <!-- D057 §3.8: the application's settings (the user's, not the project's). -->
      <Button x:Name="AppSettingsButton" Content="{x:Static l:Strings.Toolbar_AppSettings}" Command="{Binding AppSettingsCommand}"
              IsVisible="{Binding HasAppSettings}" ToolTip.Tip="{x:Static l:Strings.Toolbar_AppSettingsTip}"/>

      <!-- D068 §3: the in-app help (also F1). -->
      <Button x:Name="HelpButton" Content="?" Command="{Binding HelpCommand}" IsVisible="{Binding HasHelp}" MinWidth="30"
              FontWeight="SemiBold" HorizontalContentAlignment="Center"
              ToolTip.Tip="{x:Static l:Strings.Toolbar_HelpTip}" AutomationProperties.Name="{x:Static l:Strings.Toolbar_Help}"/>

    </WrapPanel>
    </DockPanel>
  </Border>

</UserControl>
