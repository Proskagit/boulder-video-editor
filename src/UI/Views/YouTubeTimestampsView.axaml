<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiVideoEditor.UI.Views.YouTubeTimestampsView">

  <!-- D057 §3.9: the routes' timestamps at the left edges of their green areas, to copy into a YouTube description. -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{x:Static l:Strings.YouTube_Hint}" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <CheckBox DockPanel.Dock="Top" x:Name="RangeBox" Content="{x:Static l:Strings.YouTube_FromIn}" IsChecked="{Binding UseRange, Mode=TwoWay}"
              IsVisible="{Binding HasRange}" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="CopyButton" Content="{x:Static l:Strings.YouTube_Copy}" Command="{Binding CopyCommand}" IsDefault="True"/>
      <Button Content="{x:Static l:Strings.FitSettings_Close}" Command="{Binding CloseCommand}" IsCancel="True"/>
    </StackPanel>
    <TextBox x:Name="TimestampsBox" Text="{Binding Text}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Consolas, Cascadia Mono, monospace" MinHeight="200"/>
  </DockPanel>
</UserControl>
