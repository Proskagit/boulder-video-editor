<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:AiVideoEditor.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiVideoEditor.UI.ViewModels"
             xmlns:panels="using:AiVideoEditor.UI.ViewModels.Panels"
             x:Class="AiVideoEditor.UI.Views.StartScreenView"
             x:DataType="vm:StartScreenViewModel"
             Background="{DynamicResource Surface0Brush}">

  <UserControl.Styles>
    <!-- D070 §1: a row is disabled while another entry opens (one action at a time) or while its folder is checked; Fluent
         would paint every disabled row grey, so a click seemed to select every project before the chosen one opened. A
         disabled row keeps its transparent background (the state text says Checking / Unavailable). -->
    <Style Selector="Button.recentRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <!-- D068 item 5: the first screen — the product, «Создать проект» (the one accent), «Открыть…», the recent projects. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="640" HorizontalAlignment="Center" Margin="0,64,0,32" Spacing="24">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Image Source="/Assets/app-256.png" Width="64" Height="64"/>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Boulder Video Editor" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{x:Static l:Strings.StartScreen_Tagline}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewProjectButton" Classes="accent" Content="{x:Static l:Strings.StartScreen_New}" Command="{Binding NewProjectCommand}"
                Padding="16,8"/>
        <Button x:Name="OpenProjectButton" Content="{x:Static l:Strings.StartScreen_Open}" Command="{Binding OpenCommand}" Padding="16,8"/>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding Recent, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{x:Static l:Strings.StartScreen_Recent}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{x:Static l:Strings.StartScreen_NoRecent}" Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding Recent.IsEmpty, FallbackValue=False}"/>
        <Border Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                IsVisible="{Binding !Recent.IsEmpty, FallbackValue=False}">
          <ItemsControl ItemsSource="{Binding Recent.Items, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="panels:RecentProjectItemViewModel">
                <Button Classes="recentRow" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding ToolTip}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Background="Transparent" Padding="12,8" CornerRadius="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding FolderPath}" FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextMutedBrush}" TextTrimming="PrefixCharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding LastUsedText}" FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
