<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiVideoEditor.UI</RootNamespace>
    <AssemblyName>AiVideoEditor.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- D067 §7: the application icon (tools/icon/make_icon.py). -->
    <AvaloniaResource Include="Assets\**" />
    <!-- D068 §3: the in-app help, one file per interface language (HelpDocument). -->
    <!-- WithCulture=false: "help.ru.md" stays in this assembly (not a Russian satellite) — HelpDocument picks the file. -->
    <EmbeddedResource Include="Help\help.*.md" LogicalName="AiVideoEditor.UI.Help.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rendering.Tests" />
    <InternalsVisibleTo Include="UI.Tests" />
    <InternalsVisibleTo Include="Video.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- D039: user-visible texts; English neutral, Russian satellite. MSBuild generates the strongly typed class (no package). -->
    <EmbeddedResource Update="Localization\Strings.resx" StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="AiVideoEditor.UI.Localization" StronglyTypedClassName="Strings" PublicClass="true" />
  </ItemGroup>

</Project>
